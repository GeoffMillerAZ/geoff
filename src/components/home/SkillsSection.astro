---
// Skills section component for the homepage sidebar
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl gradient-text border-b-2 border-accent/30 pb-3 mb-6">Core Skills</h2>
    
    <div class="space-y-6">
      <div>
        <div class="badge badge-accent badge-outline mb-3">Primary Expertise</div>
        <div class="flex flex-wrap gap-2">
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">Cloud Strategy</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">Infrastructure Architecture</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">Platform Engineering</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">DevOps / DevSecOps</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">Kubernetes</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">IaC & Policy-as-Code</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">CI/CD & GitOps</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">FinOps</div>
          <div class="badge badge-secondary badge-sm md:badge-md hover:badge-secondary hover:text-secondary-content transition-colors duration-300">Agentic AI Workflows</div>
        </div>
      </div>
      
      <div>
        <div class="badge badge-accent badge-outline mb-3">Languages & Frameworks</div>
        <div class="flex flex-wrap gap-2">
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">Go / Golang</div>
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">Python</div>
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">TypeScript</div>
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">Bash</div>
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">CUE</div>
          <div class="badge badge-info badge-sm md:badge-md hover:badge-info hover:text-info-content transition-colors duration-300">Nushell</div>
        </div>
      </div>
    </div>
  </div>
</div>