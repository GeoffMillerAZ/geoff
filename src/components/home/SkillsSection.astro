---
// Skills section component for the homepage sidebar
---

<div class="card p-6">
  <h2 class="text-xl lg:text-2xl font-bold text-white border-b-2 border-accent pb-2">Core Skills</h2>
  
  <div class="mt-4">
    <p class="font-semibold text-accent">Primary</p>
    <div class="flex flex-wrap mt-2">
      <span class="skill-badge">Cloud Strategy</span>
      <span class="skill-badge">Infrastructure Architecture</span>
      <span class="skill-badge">Platform Engineering</span>
      <span class="skill-badge">DevOps / DevSecOps</span>
      <span class="skill-badge">Kubernetes</span>
      <span class="skill-badge">IaC & Policy-as-Code</span>
      <span class="skill-badge">CI/CD & GitOps</span>
      <span class="skill-badge">FinOps</span>
      <span class="skill-badge">Agentic AI Workflows</span>
    </div>
    
    <p class="font-semibold text-accent mt-4">Languages & Frameworks</p>
    <div class="flex flex-wrap mt-2">
      <span class="skill-badge">Go / Golang</span>
      <span class="skill-badge">Python</span>
      <span class="skill-badge">TypeScript</span>
      <span class="skill-badge">Bash</span>
      <span class="skill-badge">CUE</span>
      <span class="skill-badge">Nushell</span>
    </div>
  </div>
</div>