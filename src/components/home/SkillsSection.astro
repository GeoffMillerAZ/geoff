---
// Skills section component for the homepage sidebar
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl gradient-text border-b-2 border-accent/30 pb-3 mb-6">Core Skills</h2>
    
    <div class="space-y-4">
      <!-- Core Skills -->
      <div>
        <h3 class="text-sm font-semibold text-primary mb-3">Core Skills</h3>
        <div class="flex gap-2 overflow-x-auto snap-x pb-2">
          <span class="badge badge-primary badge-sm snap-start shrink-0 min-h-[32px]">Kubernetes</span>
          <span class="badge badge-primary badge-sm snap-start shrink-0 min-h-[32px]">Platform Eng</span>
          <span class="badge badge-primary badge-sm snap-start shrink-0 min-h-[32px]">Cloud Arch</span>
          <span class="badge badge-primary badge-sm snap-start shrink-0 min-h-[32px]">DevOps</span>
          <span class="badge badge-primary badge-sm snap-start shrink-0 min-h-[32px]">FinOps</span>
        </div>
      </div>
      
      <!-- Languages -->
      <div>
        <h3 class="text-sm font-semibold text-secondary mb-3">Languages</h3>
        <div class="flex gap-2 overflow-x-auto snap-x pb-2">
          <span class="badge badge-outline badge-sm snap-start shrink-0 min-h-[32px]">Go</span>
          <span class="badge badge-outline badge-sm snap-start shrink-0 min-h-[32px]">Python</span>
          <span class="badge badge-outline badge-sm snap-start shrink-0 min-h-[32px]">TypeScript</span>
          <span class="badge badge-outline badge-sm snap-start shrink-0 min-h-[32px]">Bash</span>
        </div>
      </div>
      
      <!-- Show more skills -->
      <div class="collapse collapse-arrow bg-base-300/30">
        <input type="checkbox" />
        <div class="collapse-title text-sm font-medium min-h-[44px] flex items-center">Show more skills</div>
        <div class="collapse-content">
          <div class="space-y-3">
            <div>
              <span class="text-xs text-base-content/70">Infrastructure & Tools</span>
              <div class="flex flex-wrap gap-1.5 mt-1">
                <span class="badge badge-outline badge-xs">AWS</span>
                <span class="badge badge-outline badge-xs">Terraform</span>
                <span class="badge badge-outline badge-xs">ArgoCD</span>
                <span class="badge badge-outline badge-xs">Istio</span>
                <span class="badge badge-outline badge-xs">Prometheus</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>