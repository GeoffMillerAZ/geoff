---
// Skills section component for the homepage sidebar
---

<div class="card p-6 lg:p-8">
  <h2 class="text-xl lg:text-2xl font-bold text-white border-b-2 border-accent pb-2">Core Skills</h2>
  
  <div class="mt-4 space-y-4">
    <div>
      <p class="font-semibold text-accent mb-2">Primary</p>
      <div class="flex flex-wrap gap-2">
        <span class="skill-badge whitespace-nowrap">Cloud Strategy</span>
        <span class="skill-badge whitespace-nowrap">Infrastructure Architecture</span>
        <span class="skill-badge whitespace-nowrap">Platform Engineering</span>
        <span class="skill-badge whitespace-nowrap">DevOps / DevSecOps</span>
        <span class="skill-badge whitespace-nowrap">Kubernetes</span>
        <span class="skill-badge whitespace-nowrap">IaC & Policy-as-Code</span>
        <span class="skill-badge whitespace-nowrap">CI/CD & GitOps</span>
        <span class="skill-badge whitespace-nowrap">FinOps</span>
        <span class="skill-badge whitespace-nowrap">Agentic AI Workflows</span>
      </div>
    </div>
    
    <div>
      <p class="font-semibold text-accent mb-2">Languages & Frameworks</p>
      <div class="flex flex-wrap gap-2">
        <span class="skill-badge whitespace-nowrap">Go / Golang</span>
        <span class="skill-badge whitespace-nowrap">Python</span>
        <span class="skill-badge whitespace-nowrap">TypeScript</span>
        <span class="skill-badge whitespace-nowrap">Bash</span>
        <span class="skill-badge whitespace-nowrap">CUE</span>
        <span class="skill-badge whitespace-nowrap">Nushell</span>
      </div>
    </div>
  </div>
</div>