---
// Skills section component for the homepage sidebar
import { getSiteConfig } from '@/utils/siteData';

const siteConfig = getSiteConfig();
const { skills } = siteConfig;
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl text-glow-white border-b-2 border-accent/30 pb-3 mb-6">Core Skills</h2>
    
    <div class="space-y-4">
      <!-- Core Skills -->
      <div>
        <h3 class="text-lg sm:text-xl lg:text-xl font-semibold text-glow-pink mb-3">{skills.core.title}</h3>
        <div class="flex flex-wrap gap-2">
          {skills.core.items.map((skill) => (
            <span class="badge badge-primary badge-sm shrink-0 min-h-[32px]">{skill}</span>
          ))}
        </div>
      </div>
      
      <!-- Technical -->
      <div>
        <h3 class="text-lg sm:text-xl lg:text-xl font-semibold text-glow-cyan mb-3">{skills.technical.title}</h3>
        <div class="flex flex-wrap gap-2">
          {skills.technical.items.map((skill) => (
            <span class="badge badge-outline badge-sm shrink-0 min-h-[32px]">{skill}</span>
          ))}
        </div>
      </div>
      
      <!-- Show more skills -->
      <div class="collapse collapse-arrow bg-base-300/30">
        <input type="checkbox" />
        <div class="collapse-title text-sm font-medium min-h-[44px] flex items-center">Show more skills</div>
        <div class="collapse-content">
          <div class="space-y-3">
            <div>
              <span class="text-xs text-base-content/70">{skills.compliance.title}</span>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {skills.compliance.items.map((skill) => (
                  <span class="badge badge-outline badge-xs">{skill}</span>
                ))}
              </div>
            </div>
            <div class="mt-3">
              <span class="text-xs text-base-content/70">{skills.leadership.title}</span>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {skills.leadership.items.map((skill) => (
                  <span class="badge badge-outline badge-xs">{skill}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>