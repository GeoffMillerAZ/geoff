---
// Skills section component for the homepage sidebar
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl text-primary border-b-2 border-accent pb-2">Core Skills</h2>
    
    <div class="space-y-6">
      <div>
        <div class="badge badge-accent badge-outline mb-3">Primary</div>
        <div class="flex flex-wrap gap-2">
          <div class="badge badge-secondary badge-lg">Cloud Strategy</div>
          <div class="badge badge-secondary badge-lg">Infrastructure Architecture</div>
          <div class="badge badge-secondary badge-lg">Platform Engineering</div>
          <div class="badge badge-secondary badge-lg">DevOps / DevSecOps</div>
          <div class="badge badge-secondary badge-lg">Kubernetes</div>
          <div class="badge badge-secondary badge-lg">IaC & Policy-as-Code</div>
          <div class="badge badge-secondary badge-lg">CI/CD & GitOps</div>
          <div class="badge badge-secondary badge-lg">FinOps</div>
          <div class="badge badge-secondary badge-lg">Agentic AI Workflows</div>
        </div>
      </div>
      
      <div>
        <div class="badge badge-accent badge-outline mb-3">Languages & Frameworks</div>
        <div class="flex flex-wrap gap-2">
          <div class="badge badge-info badge-lg">Go / Golang</div>
          <div class="badge badge-info badge-lg">Python</div>
          <div class="badge badge-info badge-lg">TypeScript</div>
          <div class="badge badge-info badge-lg">Bash</div>
          <div class="badge badge-info badge-lg">CUE</div>
          <div class="badge badge-info badge-lg">Nushell</div>
        </div>
      </div>
    </div>
  </div>
</div>