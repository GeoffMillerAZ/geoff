---
import { getCollection } from 'astro:content';

// Get education entries only with proper type checking
const allResume = await getCollection('resume');
const allEducation = allResume.filter(item => item.data.type === 'education');

// Type assertion for education entries
type EducationEntry = {
  data: {
    type: 'education';
    degree: string;
    institution: string;
    location: string;
    graduationDate?: Date;
    gpa?: string;
    honors?: string[];
    order: number;
  };
};

const sortedEducation = (allEducation as unknown as EducationEntry[])
  .sort((a, b) => a.data.order - b.data.order);
---

<div class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300 h-full">
  <div class="card-body p-6 sm:p-5 lg:p-6">
    <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl mb-4 text-glow-white">Education</h2>
    
    <div class="space-y-3 lg:space-y-4">
      {sortedEducation.map((edu) => (
        <div class="card bg-base-300/30 border border-secondary/30 hover:border-secondary/50 transition-all duration-300 hover:shadow-lg">
          <div class="card-body p-4 sm:p-4 lg:p-5">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
              <div class="flex-1">
                <h3 class="text-base sm:text-lg lg:text-lg font-bold text-glow-cyan leading-tight">
                  {edu.data.degree}
                </h3>
                <p class="text-sm lg:text-base text-primary font-medium mt-1">
                  {edu.data.institution}
                </p>
                <p class="text-xs lg:text-sm opacity-70 mt-1">
                  {edu.data.location}
                </p>
                {(edu.data.honors && edu.data.honors.length > 0) || edu.data.gpa ? (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {edu.data.honors?.map((honor) => (
                      <span class="badge badge-accent badge-xs">{honor}</span>
                    ))}
                    {edu.data.gpa && (
                      <span class="badge badge-secondary badge-xs">GPA: {edu.data.gpa}</span>
                    )}
                  </div>
                ) : null}
              </div>
              <div class="flex-shrink-0 text-right">
                {edu.data.graduationDate && (
                  <span class="text-xs lg:text-sm font-medium text-glow-white">
                    {edu.data.graduationDate.getFullYear()}
                  </span>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>