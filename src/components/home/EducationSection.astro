---
// Education and certifications section
---

<div class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300 h-full">
  <div class="card-body p-4 sm:p-5 lg:p-6">
    <h2 class="card-title text-xl sm:text-2xl lg:text-2xl mb-4 gradient-text">Education</h2>
    
    <div class="space-y-3 lg:space-y-4">
      <!-- Master's Degree - Featured -->
      <div class="card bg-primary/10 border border-primary/30 hover:border-primary/50 transition-all duration-300">
        <div class="card-body p-3 sm:p-4 lg:p-4">
          <div class="flex items-start gap-2 lg:gap-3">
            <div class="avatar placeholder shrink-0">
              <div class="bg-primary text-primary-content rounded-lg w-10 h-10 lg:w-11 lg:h-11">
                <span class="text-base lg:text-lg font-bold">MS</span>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm lg:text-base font-bold text-primary">Master of Science</h3>
              <p class="text-sm lg:text-sm font-medium">Computer Science</p>
              <div class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-2 mt-1">
                <span class="text-xs opacity-75 truncate">Northern Illinois University</span>
                <span class="badge badge-primary badge-outline badge-xs">Jan 2015</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Bachelor's Degree -->
      <div class="card bg-base-300/30 border border-base-300/50 hover:bg-base-300/50 transition-all duration-300">
        <div class="card-body p-3 sm:p-4 lg:p-4">
          <div class="flex items-start gap-2 lg:gap-3">
            <div class="avatar placeholder shrink-0">
              <div class="bg-base-300 text-base-content rounded-lg w-10 h-10 lg:w-11 lg:h-11">
                <span class="text-base lg:text-lg font-bold">BS</span>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm lg:text-base font-bold">Bachelor of Science</h3>
              <p class="text-sm lg:text-sm font-medium">Computer Science</p>
              <div class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-2 mt-1">
                <span class="text-xs opacity-75 truncate">Northern Illinois University</span>
                <span class="badge badge-secondary badge-outline badge-xs">Jan 2013</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>