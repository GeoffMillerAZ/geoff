---
// Education and certifications section
---

<div class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl mb-4 gradient-text">Education</h2>
    <div class="divider mt-0 mb-6"></div>
    
    <div class="space-y-4">
      <div class="alert alert-info bg-info/10 border-info/30 hover:bg-info/15 hover:border-info/40 hover:shadow-lg transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6 group-hover:scale-110 transition-transform duration-300">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7" />
        </svg>
        <div>
          <h3 class="font-bold">Master of Science, Computer Science</h3>
          <div class="text-xs opacity-70">
            Northern Illinois University — DeKalb, IL
            <span class="badge badge-info badge-outline badge-sm ml-2 hover:badge-info hover:text-info-content transition-all duration-300">Jan 2015</span>
          </div>
        </div>
      </div>
      
      <div class="alert bg-base-300/30 border-base-300/50 hover:bg-base-300/50 hover:border-base-300/70 hover:shadow-lg transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6 group-hover:scale-110 transition-transform duration-300">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7" />
        </svg>
        <div>
          <h3 class="font-bold">Bachelor of Science, Computer Science</h3>
          <div class="text-xs opacity-70">
            Northern Illinois University — DeKalb, IL
            <span class="badge badge-secondary badge-outline badge-sm ml-2 hover:badge-secondary hover:text-secondary-content transition-all duration-300">Jan 2013</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>