---
// Profile card component for the homepage sidebar
import { getSiteConfig } from '@/utils/siteData';
import { getThemeConfig } from '@/utils/themeData';
import Avatar from '@/components/ui/Avatar.astro';

const siteConfig = getSiteConfig();
const themeConfig = getThemeConfig();
const { profile, resume } = siteConfig;
const showAvatar = themeConfig.components.avatar.show && profile.showAvatar;
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl hover:shadow-2xl transition-all duration-300">
  <!-- Compact mobile layout / Regular desktop layout -->
  <div class="card-body p-4 sm:p-6 md:p-6">
    <!-- Mobile: Horizontal layout with avatar and info side by side -->
    <div class="sm:hidden">
      <div class="flex gap-4 items-start">
        {showAvatar && (
          <div class="shrink-0">
            <Avatar size="small" />
          </div>
        )}
        <div class="flex-1 min-w-0">
          <h1 class="text-xl font-bold text-glow-white animate-glow leading-tight">{profile.name}</h1>
          <p class="text-glow-cyan text-sm mt-1 leading-tight">{profile.title}</p>
          <div class="flex items-center gap-1 mt-2">
            <svg class="w-3 h-3 text-glow-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-xs text-glow-pink">{profile.location}</span>
          </div>
        </div>
      </div>
      
      <!-- Mobile: Compact social links -->
      <div class="flex gap-2 mt-4">
        <a href={profile.social.github?.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm flex-1 gap-1 min-h-[40px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="text-xs">{profile.social.github?.username}</span>
        </a>
        
        <a href={profile.social.linkedin?.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm flex-1 gap-1 min-h-[40px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span class="text-xs">{profile.social.linkedin?.username}</span>
        </a>
      </div>
      
      <!-- Mobile: Compact CTA buttons -->
      <div class="mt-3">
        <p class="text-xs text-base-content/70 text-center mb-2">Open to Staff+ platform roles</p>
        <div class="flex gap-2">
          <a href={profile.social.linkedin?.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm flex-1 min-h-[40px]">
            Contact
          </a>
          <a href={resume.downloadUrl} download={resume.filename} class="btn btn-outline btn-sm flex-1 min-h-[40px]">
            Resume
          </a>
        </div>
      </div>
    </div>
    
    <!-- Desktop/Tablet: Original centered layout -->
    <div class="hidden sm:block text-center">
      <div class="flex flex-col items-center">
        {showAvatar && (
          <div class="mb-4">
            <Avatar size="medium" className="mx-auto" />
          </div>
        )}
        <h1 class="card-title text-2xl md:text-3xl lg:text-4xl font-bold justify-center text-glow-white animate-glow">{profile.name}</h1>
      </div>
      <p class="text-accent font-medium mt-2 text-sm md:text-base lg:text-lg leading-relaxed">{profile.title}</p>
      <div class="badge badge-secondary badge-outline badge-md mt-3 hover:badge-secondary hover:text-secondary-content transition-all duration-300">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        {profile.location}
      </div>
      
      <div class="divider my-4"></div>
      
      <div class="space-y-3">
        <a href={profile.social.github?.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost justify-start group w-full hover:bg-primary/10 transition-all duration-300 min-h-[44px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:text-primary group-hover:scale-110 transition-all duration-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="ml-3 truncate group-hover:text-primary transition-colors duration-300">{profile.social.github?.username}</span>
        </a>
        
        <a href={profile.social.linkedin?.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost justify-start group w-full hover:bg-secondary/10 transition-all duration-300 min-h-[44px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:text-secondary group-hover:scale-110 transition-all duration-300" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span class="ml-3 truncate group-hover:text-secondary transition-colors duration-300">{profile.social.linkedin?.username}</span>
        </a>
      </div>
      
      <div class="divider my-4"></div>
      <div class="text-center space-y-3">
        <p class="text-sm text-base-content/70">Open to Staff+ platform roles</p>
        <div class="card-actions justify-center">
          <a href={profile.social.linkedin?.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm min-h-[44px] gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            Contact Me
          </a>
          <a href={resume.downloadUrl} download={resume.filename} class="btn btn-outline btn-sm min-h-[44px]">
            Resume
          </a>
        </div>
      </div>
    </div>
  </div>
</div>