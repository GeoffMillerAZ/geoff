---
// Profile card component for the homepage sidebar
---

<div class="card bg-base-200/80 backdrop-blur-sm shadow-xl hover:shadow-2xl transition-all duration-300">
  <div class="card-body text-center p-4 md:p-6">
    <!-- Avatar Section -->
    <div class="avatar placeholder mb-4">
      <div class="bg-primary text-primary-content w-24 h-24 rounded-full ring ring-secondary ring-offset-base-100 ring-offset-2 hover:ring-accent transition-all duration-300">
        <span class="text-3xl font-bold">GM</span>
      </div>
    </div>
    
    <h1 class="card-title text-2xl md:text-3xl lg:text-4xl font-bold text-primary justify-center gradient-text animate-glow">Geoffrey Miller</h1>
    <p class="text-accent font-medium mt-2 text-sm md:text-base lg:text-lg leading-relaxed">Infrastructure Director & Principal Cloud Architect</p>
    <div class="badge badge-secondary badge-outline badge-md mt-3 hover:badge-secondary hover:text-secondary-content transition-all duration-300">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Phoenix, AZ
    </div>
  </div>
  
  <!-- Contact Links -->
  <div class="card-body pt-0 p-4 md:p-6">
    <div class="space-y-3">
      <a href="https://github.com/GeoffMillerAZ" target="_blank" rel="noopener noreferrer" class="btn btn-ghost justify-start group w-full hover:bg-primary/10 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:text-primary group-hover:scale-110 transition-all duration-300" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="ml-3 truncate group-hover:text-primary transition-colors duration-300">github.com/GeoffMillerAZ</span>
      </a>
      
      <a href="https://linkedin.com/in/geoff-e-miller" target="_blank" rel="noopener noreferrer" class="btn btn-ghost justify-start group w-full hover:bg-secondary/10 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:text-secondary group-hover:scale-110 transition-all duration-300" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        <span class="ml-3 truncate group-hover:text-secondary transition-colors duration-300">linkedin.com/in/geoff-e-miller</span>
      </a>
    </div>
    
    <div class="divider my-4"></div>
    <div class="alert bg-info/10 border-info/30 hover:bg-info/15 transition-all duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div class="text-xs md:text-sm leading-relaxed">
        Please feel free to contact me via 
        <a href="https://linkedin.com/in/geoff-e-miller" target="_blank" rel="noopener noreferrer" class="link link-info font-medium hover:link-hover transition-colors duration-300 hover:text-secondary">
          LinkedIn
        </a> for professional opportunities.
      </div>
    </div>
  </div>
</div>