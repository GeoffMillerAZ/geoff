---
import { getCollection } from 'astro:content';

// Get certification entries only
const allCertifications = await getCollection('resume', ({ data }) => data.type === 'certification');
const sortedCertifications = allCertifications.sort((a, b) => a.data.order - b.data.order);
---

<div class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl mb-4 gradient-text">Professional Certifications</h2>
    <div class="divider mt-0 mb-6"></div>
    
    <div class="grid gap-3 sm:grid-cols-1 lg:grid-cols-2">
      {sortedCertifications.length > 0 ? (
        sortedCertifications.map((cert) => (
          <div class="alert alert-success bg-success/10 border-success/30 hover:bg-success/15 hover:border-success/40 hover:shadow-lg transition-all duration-300 group">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-success shrink-0 w-5 h-5 group-hover:scale-110 transition-transform duration-300">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm lg:text-base truncate">
                {cert.data.name}
              </h3>
              <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 mt-2">
                <span class="badge badge-secondary badge-sm flex-shrink-0 hover:badge-secondary hover:text-secondary-content transition-all duration-300">{cert.data.issuer}</span>
                {cert.data.issueDate && (
                  <span class="text-xs opacity-70 flex-shrink-0">
                    {new Date(cert.data.issueDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </span>
                )}
              </div>
            </div>
          </div>
        ))
      ) : (
        /* Fallback to hardcoded certifications */
        <>
          <div class="alert alert-success bg-success/10 border-success/30 hover:bg-success/15 hover:border-success/40 hover:shadow-lg transition-all duration-300 group">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-success shrink-0 w-5 h-5 group-hover:scale-110 transition-transform duration-300">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm lg:text-base truncate">
                AWS Certified Solutions Architect – Associate
              </h3>
              <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 mt-2">
                <span class="badge badge-secondary badge-sm flex-shrink-0 hover:badge-secondary hover:text-secondary-content transition-all duration-300">Amazon Web Services</span>
                <span class="text-xs opacity-70 flex-shrink-0">2023</span>
              </div>
            </div>
          </div>
          <div class="alert alert-success bg-success/10 border-success/30 hover:bg-success/15 hover:border-success/40 hover:shadow-lg transition-all duration-300 group">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-success shrink-0 w-5 h-5 group-hover:scale-110 transition-transform duration-300">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm lg:text-base truncate">
                AWS Certified Developer – Associate
              </h3>
              <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 mt-2">
                <span class="badge badge-secondary badge-sm flex-shrink-0 hover:badge-secondary hover:text-secondary-content transition-all duration-300">Amazon Web Services</span>
                <span class="text-xs opacity-70 flex-shrink-0">2022</span>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</div>