---
import { getCollection } from 'astro:content';

// Get certification entries only
const allCertifications = await getCollection('resume', ({ data }) => data.type === 'certification');
const sortedCertifications = allCertifications.sort((a, b) => a.data.order - b.data.order);
---

<div class="card bg-base-200/80 shadow-xl backdrop-blur-md">
  <div class="card-body">
    <h2 class="card-title text-xl lg:text-2xl mb-4">Certifications</h2>
    <div class="divider mt-0"></div>
    
    <div class="space-y-3">
      {sortedCertifications.length > 0 ? (
        sortedCertifications.map((cert) => (
          <div class="card bg-base-300/50 hover:bg-base-300/70 transition-colors">
            <div class="card-body p-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-accent shrink-0 w-5 h-5 mt-1">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <div class="flex-1">
                  <h3 class="font-bold text-sm lg:text-base">
                    {cert.data.name}
                  </h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="badge badge-secondary badge-sm">{cert.data.issuer}</span>
                    {cert.data.issueDate && (
                      <span class="text-xs opacity-50">
                        {new Date(cert.data.issueDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      ) : (
        /* Fallback to hardcoded certifications */
        <>
          <div class="card bg-base-300/50 hover:bg-base-300/70 transition-colors">
            <div class="card-body p-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-accent shrink-0 w-5 h-5 mt-1">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <div class="flex-1">
                  <h3 class="font-bold text-sm lg:text-base">
                    AWS Certified Solutions Architect – Associate
                  </h3>
                  <span class="badge badge-secondary badge-sm mt-1">Amazon Web Services</span>
                </div>
              </div>
            </div>
          </div>
          <div class="card bg-base-300/50 hover:bg-base-300/70 transition-colors">
            <div class="card-body p-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-accent shrink-0 w-5 h-5 mt-1">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <div class="flex-1">
                  <h3 class="font-bold text-sm lg:text-base">
                    AWS Certified Developer – Associate
                  </h3>
                  <span class="badge badge-secondary badge-sm mt-1">Amazon Web Services</span>
                </div>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</div>