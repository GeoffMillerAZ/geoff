---
import { getCollection } from 'astro:content';

// Get all resume entries and filter for certifications
const allResume = await getCollection('resume');
const allCertifications = allResume.filter(item => item.data.type === 'certification');
const sortedCertifications = allCertifications.sort((a, b) => a.data.order - b.data.order);
---

<div class="card p-6 lg:p-8">
  <h2 class="text-xl lg:text-2xl font-bold text-white border-b-2 border-accent pb-2 mb-4">Certifications</h2>
  
  <div class="space-y-4">
    {sortedCertifications.length > 0 ? (
      sortedCertifications.map((cert) => (
        <div class="border-l-2 border-synth-border pl-4 hover:border-accent transition-colors">
          <h3 class="font-semibold text-white text-sm lg:text-base leading-tight mb-1">
            {cert.data.name}
          </h3>
          <p class="text-xs lg:text-sm text-synth-text-muted">
            {cert.data.issuer}
          </p>
          {cert.data.issueDate && (
            <p class="text-xs text-gray-500 mt-1">
              Issued: {new Date(cert.data.issueDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </p>
          )}
        </div>
      ))
    ) : (
      /* Fallback to hardcoded certifications */
      <>
        <div class="border-l-2 border-synth-border pl-4 hover:border-accent transition-colors">
          <h3 class="font-semibold text-white text-sm lg:text-base leading-tight mb-1">
            AWS Certified Solutions Architect – Associate
          </h3>
          <p class="text-xs lg:text-sm text-synth-text-muted">
            Amazon Web Services
          </p>
        </div>
        <div class="border-l-2 border-synth-border pl-4 hover:border-accent transition-colors">
          <h3 class="font-semibold text-white text-sm lg:text-base leading-tight mb-1">
            AWS Certified Developer – Associate
          </h3>
          <p class="text-xs lg:text-sm text-synth-text-muted">
            Amazon Web Services
          </p>
        </div>
      </>
    )}
  </div>
</div>