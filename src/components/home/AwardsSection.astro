---
import { getCollection } from 'astro:content';

// Get award entries with proper type checking
const allResume = await getCollection('resume');
const allAwards = allResume.filter(item => item.data.type === 'award');

// Type assertion for awards
type AwardEntry = {
  data: {
    type: 'award';
    title: string;
    organization: string;
    description?: string;
    date?: Date;
    order: number;
  };
};

const sortedAwards = (allAwards as unknown as AwardEntry[]).sort((a, b) => {
  // Sort by date descending (most recent first)
  const dateA = a.data.date ? new Date(a.data.date) : new Date(0);
  const dateB = b.data.date ? new Date(b.data.date) : new Date(0);
  return dateB.getTime() - dateA.getTime();
});

// Only show section if there are awards
const hasAwards = sortedAwards.length > 0;

// Fallback data if no content collection entries
const fallbackAwards = [
  {
    title: "DECA National Competition - First Place",
    organization: "DECA",
    description: "First Place in Extemporaneous Speaking; Top 10 Overall Finalist",
    date: "2004-04-01"
  },
  {
    title: "DECA Illinois State Competition - First Place",
    organization: "DECA Illinois",
    description: "First Place in Extemporaneous Speaking; Third Place Overall",
    date: "2004-03-01"
  }
];

const awards = sortedAwards.length > 0 ? sortedAwards.map(a => a.data) : fallbackAwards;
---

{(hasAwards || fallbackAwards.length > 0) && (
  <section id="awards" class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300 h-full">
    <div class="card-body p-6 sm:p-5 lg:p-6">
      <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl mb-4 text-glow-white">Awards & Recognition</h2>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 lg:gap-4">
        {awards.map((award) => (
          <div class="card bg-base-300/30 border border-primary/30 hover:border-primary/50 transition-all duration-300">
            <div class="card-body p-4">
              <div class="flex items-start gap-3">
                <div class="avatar placeholder shrink-0">
                  <div class="bg-primary text-primary-content rounded-lg w-10 h-10 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                  </div>
                </div>
                <div class="flex-1">
                  <h3 class="text-sm font-bold text-glow-pink">{award.title}</h3>
                  <p class="text-xs text-glow-cyan mt-1">{award.organization}</p>
                  {award.description && (
                    <p class="text-xs mt-2 text-white/70">{award.description}</p>
                  )}
                  {award.date && (
                    <p class="text-xs mt-2 opacity-60">
                      {new Date(award.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                    </p>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}