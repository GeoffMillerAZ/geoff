              <time class="text-sm opacity-75 font-mono">
                {formatDate(exp.data.startDate)} - {formatDate(exp.data.endDate, exp.data.current)}
              </time>
            </div>
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="badge badge-secondary badge-outline badge-sm">
                {exp.data.company}
