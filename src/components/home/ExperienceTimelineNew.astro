---
import { getCollection } from 'astro:content';

// Get experience entries only with proper type checking
const allResume = await getCollection('resume');
const allExperience = allResume.filter(item => item.data.type === 'experience');

// Type assertion for experience entries
type ExperienceEntry = {
  data: {
    type: 'experience';
    position: string;
    company: string;
    companyTransition?: {
      type: 'formerly' | 'now';
      name: string;
      location?: string;
    };
    location: string;
    workType?: 'remote' | 'on-site' | 'hybrid';
    startDate: Date;
    endDate?: Date;
    current: boolean;
    highlights?: string[];
    technologies?: string[];
    showInMainSection: boolean;
    order: number;
  };
};

const typedExperience = allExperience as unknown as ExperienceEntry[];
const mainExperience = typedExperience
  .filter(exp => exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);
const additionalExperience = typedExperience
  .filter(exp => !exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);

// Format date helper
function formatDate(date: Date | undefined, current: boolean = false): string {
  if (current) return 'Present';
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

// Get work type badge info
function getWorkTypeBadge(workType?: 'remote' | 'on-site' | 'hybrid') {
  switch (workType) {
    case 'remote':
      return { label: 'Remote', class: 'badge-info', icon: '🌐' };
    case 'hybrid':
      return { label: 'Hybrid', class: 'badge-warning', icon: '🔄' };
    case 'on-site':
      return { label: 'On-site', class: 'badge-success', icon: '🏢' };
    default:
      return null;
  }
}
---

