---
import { getCollection } from 'astro:content';

// Get experience entries only
const allExperience = await getCollection('resume', ({ data }) => data.type === 'experience');
const mainExperience = allExperience
  .filter(exp => exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);
const additionalExperience = allExperience
  .filter(exp => !exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);

// Format date helper
function formatDate(date: Date | undefined, current: boolean = false): string {
  if (current) return 'Present';
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<section id="experience" class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300">
  <div class="card-body p-4 sm:p-6">
    <h2 class="card-title text-xl sm:text-2xl lg:text-3xl xl:text-4xl mb-4 sm:mb-6 gradient-text leading-tight">Professional Experience</h2>
  
    <div class="max-w-4xl">
      <ul class="timeline timeline-snap-icon timeline-compact timeline-vertical">
        {mainExperience.map((exp, index) => (
          <li>
            <div class="timeline-start md:text-end mb-2">
              <time class="font-mono text-sm opacity-75">
                {formatDate(exp.data.startDate)} - {formatDate(exp.data.endDate, exp.data.current)}
              </time>
            </div>
            <div class="timeline-middle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-secondary">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="timeline-end mb-6 lg:mb-8">
              <div class="text-base sm:text-lg md:text-xl lg:text-2xl font-bold mt-1 sm:mt-2 text-primary leading-tight">{exp.data.position}</div>
              <div class="text-xs sm:text-sm md:text-base opacity-75 mt-2 sm:mt-3 flex flex-wrap items-center gap-2">
                <span class="badge badge-secondary badge-outline badge-sm hover:badge-secondary hover:text-secondary-content transition-all duration-300">{exp.data.company}</span>
                <span class="text-xs text-base-content/60 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {exp.data.location}
                </span>
              </div>
          
            {exp.data.highlights && exp.data.highlights.length > 0 && (
              <>
                {/* Show first 3 highlights by default */}
                <ul class="mt-2 space-y-1 text-xs md:text-sm">
                  {exp.data.highlights.slice(0, 3).map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="text-secondary mt-0.5 text-xs md:text-sm">▸</span>
                      <span class="leading-relaxed">{highlight}</span>
                    </li>
                  ))}
                </ul>
                
                {/* Show remaining highlights in collapsible */}
                {exp.data.highlights.length > 3 && (
                  <div class="collapse collapse-arrow bg-base-300/30 hover:bg-base-300/50 mt-3 rounded-lg border border-base-300/30 transition-all duration-300">
                    <input type="checkbox" />
                    <div class="collapse-title text-sm sm:text-base font-medium py-4 sm:py-3 min-h-[44px] flex items-center hover:text-accent transition-colors duration-300 touch-manipulation cursor-pointer">
                      <span class="flex items-center gap-2 w-full">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                        </svg>
                        <span class="text-sm sm:text-base">Show {exp.data.highlights.length - 3} more achievements</span>
                      </span>
                    </div>
                    <div class="collapse-content">
                      <ul class="space-y-1 text-xs md:text-sm">
                        {exp.data.highlights.slice(3).map((highlight) => (
                          <li class="flex items-start gap-2">
                            <span class="text-secondary mt-0.5 text-xs md:text-sm">▸</span>
                            <span class="leading-relaxed">{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
              </>
            )}
            </div>
            <hr class="bg-base-300" />
          </li>
        ))}
      </ul>
    </div>

    {/* Additional Experience Section */}
    {additionalExperience.length > 0 && (
      <div class="collapse collapse-plus bg-base-300/30 hover:bg-base-300/50 mt-8 rounded-xl border border-base-300/30 transition-all duration-300">
        <input type="checkbox" />
        <div class="collapse-title text-base sm:text-lg font-medium py-4 sm:py-3 min-h-[48px] flex items-center hover:text-accent transition-colors duration-300 touch-manipulation cursor-pointer">
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
            Additional Experience ({additionalExperience.length} positions)
          </span>
        </div>
        <div class="collapse-content">
          <div class="max-w-4xl">
            <ul class="timeline timeline-snap-icon timeline-compact timeline-vertical">
              {additionalExperience.map((exp) => (
                <li>
                  <div class="timeline-middle">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="timeline-end mb-6">
                    <time class="font-mono italic text-xs opacity-50">
                      {formatDate(exp.data.startDate)} - {formatDate(exp.data.endDate, exp.data.current)}
                    </time>
                    <div class="text-lg font-bold mt-1 text-primary">{exp.data.position}</div>
                    <div class="text-sm opacity-75 mt-2 flex flex-wrap items-center gap-2">
                      <span class="badge badge-accent badge-outline badge-sm hover:badge-accent hover:text-accent-content transition-all duration-300">{exp.data.company}</span>
                      <span class="text-xs text-base-content/60 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        {exp.data.location}
                      </span>
                    </div>
                    {exp.data.highlights && exp.data.highlights.length > 0 && (
                      <ul class="mt-2 space-y-1 text-sm">
                        {exp.data.highlights.map((highlight) => (
                          <li class="flex items-start gap-2">
                            <span class="text-accent mt-0.5 text-xs">▸</span>
                            <span class="leading-relaxed">{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <hr class="bg-base-300" />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

