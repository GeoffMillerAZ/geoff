---
import { getCollection } from 'astro:content';

// Get experience entries only
const allExperience = await getCollection('resume', ({ data }) => data.type === 'experience');
const mainExperience = allExperience
  .filter(exp => exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);
const additionalExperience = allExperience
  .filter(exp => !exp.data.showInMainSection)
  .sort((a, b) => a.data.order - b.data.order);

// Format date helper
function formatDate(date: Date | undefined, current: boolean = false): string {
  if (current) return 'Present';
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<section id="experience" class="card bg-base-200/80 shadow-xl backdrop-blur-md">
  <div class="card-body">
    <h2 class="card-title text-2xl lg:text-3xl xl:text-4xl mb-6">Professional Experience</h2>
  
    <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
      {mainExperience.map((exp, index) => (
        <li>
          <div class="timeline-middle">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-secondary">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="timeline-end mb-10">
            <time class="font-mono italic text-sm opacity-50">
              {formatDate(exp.data.startDate)} - {formatDate(exp.data.endDate, exp.data.current)}
            </time>
            <div class="text-lg lg:text-xl xl:text-2xl font-bold">{exp.data.position}</div>
            <div class="text-sm opacity-75">
              <span class="badge badge-secondary badge-outline">{exp.data.company}</span>
              <span class="ml-2 text-xs">{exp.data.location}</span>
            </div>
          
            {exp.data.highlights && exp.data.highlights.length > 0 && (
              <>
                {/* Show first 3 highlights by default */}
                <ul class="mt-3 space-y-1 text-sm lg:text-base">
                  {exp.data.highlights.slice(0, 3).map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="text-secondary mt-1">▸</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
                
                {/* Show remaining highlights in collapsible */}
                {exp.data.highlights.length > 3 && (
                  <div class="collapse collapse-arrow bg-base-300/50 mt-2">
                    <input type="checkbox" />
                    <div class="collapse-title text-sm font-medium">
                      Show {exp.data.highlights.length - 3} more achievements
                    </div>
                    <div class="collapse-content">
                      <ul class="space-y-1 text-sm lg:text-base">
                        {exp.data.highlights.slice(3).map((highlight) => (
                          <li class="flex items-start gap-2">
                            <span class="text-secondary mt-1">▸</span>
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
              </>
            )}
          </div>
          <hr class="bg-base-300" />
        </li>
      ))}
    </ul>

    {/* Additional Experience Section */}
    {additionalExperience.length > 0 && (
      <div class="collapse collapse-plus bg-base-300/50 mt-6">
        <input type="checkbox" />
        <div class="collapse-title text-lg font-medium">
          Additional Experience ({additionalExperience.length} positions)
        </div>
        <div class="collapse-content">
          <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
            {additionalExperience.map((exp) => (
              <li>
                <div class="timeline-middle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="timeline-end mb-10">
                  <time class="font-mono italic text-sm opacity-50">
                    {formatDate(exp.data.startDate)} - {formatDate(exp.data.endDate, exp.data.current)}
                  </time>
                  <div class="text-lg lg:text-xl font-bold">{exp.data.position}</div>
                  <div class="text-sm opacity-75">
                    <span class="badge badge-accent badge-outline">{exp.data.company}</span>
                    <span class="ml-2 text-xs">{exp.data.location}</span>
                  </div>
                  {exp.data.highlights && exp.data.highlights.length > 0 && (
                    <ul class="mt-3 space-y-1 text-sm lg:text-base">
                      {exp.data.highlights.map((highlight) => (
                        <li class="flex items-start gap-2">
                          <span class="text-accent mt-1">▸</span>
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <hr class="bg-base-300" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</section>

