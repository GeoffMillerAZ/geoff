---
// Technical achievements section using DaisyUI stats component
import { getSiteConfig } from '@/utils/siteData';

const siteConfig = getSiteConfig();
const { achievements } = siteConfig;

// Icon mapping
const getIcon = (iconName: string) => {
  const icons: Record<string, string> = {
    currency: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    lightning: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    team: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  };
  return icons[iconName] || icons.currency;
};

// Color mapping for variety
const colors = ['accent', 'secondary', 'success', 'info'];
---

<section id="achievements" class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl mb-6 text-glow-white">Key Technical Achievements</h2>
  
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {achievements.map((achievement, index) => (
        <div class="stats shadow-lg bg-base-300/50">
          <div class={`stat hover:bg-${colors[index % colors.length]}/10 transition-all duration-300 group`}>
            <div class={`stat-figure text-${colors[index % colors.length]} group-hover:text-primary transition-colors duration-300 flex items-center`}>
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getIcon(achievement.icon)} />
              </svg>
            </div>
            <div class="stat-title text-sm text-left">{achievement.title}</div>
            <div class={`stat-value ${index % 2 === 0 ? 'text-glow-pink' : 'text-glow-cyan'} text-3xl md:text-4xl text-left`}>
              {achievement.value}
            </div>
            <div class="stat-desc text-xs leading-relaxed text-left">
              {achievement.description}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>