---
// Technical achievements section using DaisyUI stats component
---

<section id="achievements" class="card bg-base-200/80 shadow-xl backdrop-blur-md hover:shadow-2xl transition-all duration-300">
  <div class="card-body">
    <h2 class="card-title text-2xl lg:text-3xl xl:text-4xl mb-6 gradient-text">Key Technical Achievements</h2>
  
    <div class="stats stats-vertical lg:stats-horizontal shadow-lg bg-base-300/50 w-full">
      <div class="stat hover:bg-accent/10 transition-all duration-300 group">
        <div class="stat-figure text-accent group-hover:text-primary transition-colors duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <div class="stat-title text-sm">Build Time</div>
        <div class="stat-value text-accent text-xl md:text-2xl">3x Faster</div>
        <div class="stat-desc text-xs leading-relaxed">
          CI pipelines in 2024
        </div>
      </div>
      
      <div class="stat hover:bg-secondary/10 transition-all duration-300 group">
        <div class="stat-figure text-secondary group-hover:text-primary transition-colors duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="stat-title text-sm">Cost Savings</div>
        <div class="stat-value text-secondary text-xl md:text-2xl">70% Saved</div>
        <div class="stat-desc text-xs leading-relaxed">
          Infrastructure optimization
        </div>
      </div>
    </div>
    
    <div class="stats stats-vertical lg:stats-horizontal shadow-lg bg-base-300/50 w-full mt-4">
      <div class="stat hover:bg-success/10 transition-all duration-300 group">
        <div class="stat-figure text-success group-hover:text-primary transition-colors duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div class="stat-title text-sm">Platform Scale</div>
        <div class="stat-value text-success text-xl md:text-2xl">100+ Accounts</div>
        <div class="stat-desc text-xs leading-relaxed">
          Multi-account AWS architecture
        </div>
      </div>
      
      <div class="stat hover:bg-info/10 transition-all duration-300 group">
        <div class="stat-figure text-info group-hover:text-primary transition-colors duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <div class="stat-title text-sm">Orchestration</div>
        <div class="stat-value text-info text-xl md:text-2xl">EKS + GitOps</div>
        <div class="stat-desc text-xs leading-relaxed">
          Production-ready K8s platform
        </div>
      </div>
    </div>
  </div>
</section>