---
// Header component for main navigation
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/', current: currentPath === '/' },
  { name: 'About', href: '/about', current: currentPath === '/about' },
  { name: 'Blog', href: '/blog', current: currentPath.startsWith('/blog') },
  { name: 'Projects', href: '/projects', current: currentPath.startsWith('/projects') },
  { name: 'Guides', href: '/guides', current: currentPath.startsWith('/guides') },
  { name: 'Resources', href: '/resources', current: currentPath.startsWith('/resources') },
  { name: 'Contact', href: '/contact', current: currentPath === '/contact' },
];
---

<header class="sticky top-0 z-50 mx-4 mt-4 max-w-10xl 3xl:mx-auto">
  <div class="navbar bg-base-200/80 backdrop-blur-md border border-primary/30 rounded-2xl shadow-lg">
    <!-- Logo/Brand -->
    <div class="navbar-start">
      <a href="/" class="btn btn-ghost text-xl font-bold text-primary hover:text-accent">
        Geoffrey Miller
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1">
        {navItems.map(item => (
          <li>
            <a 
              href={item.href}
              class={`font-medium transition-colors ${
                item.current 
                  ? 'text-accent bg-accent/10' 
                  : 'text-base-content hover:text-accent hover:bg-accent/5'
              }`}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile Menu -->
    <div class="navbar-end lg:hidden">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost lg:hidden" aria-label="Toggle mobile menu">
          <svg 
            class="w-6 h-6" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </div>
        <ul 
          tabindex="0" 
          class="menu menu-sm dropdown-content bg-base-200/95 backdrop-blur-sm rounded-box z-50 mt-3 w-52 p-2 shadow-lg border border-primary/20"
        >
          {navItems.map(item => (
            <li>
              <a 
                href={item.href}
                class={`font-medium transition-colors ${
                  item.current 
                    ? 'text-accent bg-accent/10' 
                    : 'text-base-content hover:text-accent hover:bg-accent/5'
                }`}
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  // DaisyUI dropdown handles mobile menu functionality automatically
  // No additional JavaScript required for basic dropdown behavior
  
  // Optional: Close dropdown when clicking on menu items (for better UX)
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('.menu a') && target.closest('.dropdown')) {
      // Remove focus from dropdown to close it
      const dropdown = target.closest('.dropdown');
      const dropdownToggle = dropdown?.querySelector('[tabindex="0"]') as HTMLElement;
      dropdownToggle?.blur();
    }
  });
</script>