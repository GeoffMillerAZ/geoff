---
// Footer component with social links and site information
import { getSiteConfig } from '@/utils/siteData';

const siteConfig = getSiteConfig();
const { profile, footer, navigation } = siteConfig;
---

<footer class="footer footer-center bg-base-200/50 backdrop-blur-sm text-base-content rounded-t-2xl mt-8 sm:mt-12 border-t border-primary/20">
  <div class="container mx-auto p-4 sm:p-8 md:p-10">
    <!-- Mobile Layout -->
    <div class="sm:hidden space-y-4">
      <!-- Brand -->
      <div class="text-center">
        <div class="text-lg font-bold text-glow-white">{profile.name}</div>
        <p class="text-xs opacity-70 mt-1">
          {profile.title}
        </p>
      </div>
      
      <!-- Quick Links Grid -->
      <div class="text-center">
        <div class="text-glow-cyan text-xs uppercase tracking-wider mb-2">Quick Links</div>
        <div class="flex justify-center gap-3 text-sm flex-wrap">
          {navigation.slice(1).map((item, index) => (
            <>
              <a href={item.href} class="text-white/70 hover:text-glow-cyan transition-colors">{item.name}</a>
              {index < navigation.slice(1).length - 1 && <span class="text-white/30">•</span>}
            </>
          ))}
        </div>
      </div>
      
      <!-- Social & Location -->
      <div class="flex items-center justify-center gap-4">
        {profile.social.github && (
          <a 
            href={profile.social.github.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm btn-square hover:text-glow-pink"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        )}
        <span class="text-xs opacity-70">{profile.location}</span>
        {profile.social.linkedin && (
          <a 
            href={profile.social.linkedin.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm btn-square hover:text-glow-pink"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
    
    <!-- Desktop Layout -->
    <div class="hidden sm:grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 max-w-6xl">
      
      <!-- Brand Section -->
      <div class="space-y-3 sm:space-y-4">
        <div class="text-base sm:text-lg font-bold text-glow-white">{profile.name}</div>
        <p class="text-sm sm:text-base opacity-70 leading-relaxed">
          {profile.summary.brief}
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3 sm:space-y-4">
        <div class="footer-title text-glow-cyan opacity-100 text-sm sm:text-base">Quick Links</div>
        <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm sm:text-base">
          {navigation.slice(1).map((item) => (
            <a href={item.href} class="text-white/70 hover:text-glow-cyan min-h-[44px] flex items-center touch-manipulation transition-colors">{item.name}</a>
          ))}
        </nav>
      </div>

      <!-- Social Links -->
      <div class="space-y-3 sm:space-y-4">
        <div class="footer-title text-glow-cyan opacity-100 text-sm sm:text-base">Connect</div>
        <div class="flex justify-center md:justify-start space-x-3 sm:space-x-4">
          <a 
            href={profile.social.github?.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-ghost btn-md btn-square hover:text-glow-pink hover:bg-accent/10 min-h-[44px] min-w-[44px] touch-manipulation transition-all duration-200"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a 
            href={profile.social.linkedin?.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-ghost btn-md btn-square hover:text-glow-pink hover:bg-accent/10 min-h-[44px] min-w-[44px] touch-manipulation transition-all duration-200"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
        <div class="text-sm sm:text-base text-center md:text-left">
          <p class="text-white/70">{profile.location}</p>
          <p class="mt-1 sm:mt-2 text-white/70">
            Contact via 
            <a 
              href={profile.social.linkedin?.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-glow-cyan font-medium py-2 px-1 min-h-[44px] inline-flex items-center touch-manipulation hover:text-glow-pink transition-colors"
            >
              LinkedIn
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="divider my-4 sm:my-6"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-2 sm:gap-4">
      <div class="text-xs opacity-60 text-center sm:text-left">
        <p>
          © {new Date().getFullYear()} {footer.copyright}. Built with 
          {footer.poweredBy.map((tech, index) => (
            <>
              <a href={tech.url} target="_blank" rel="noopener noreferrer" class="link link-accent hover:text-glow-cyan">{tech.name}</a>
              {index < footer.poweredBy.length - 1 && ', '}
            </>
          ))}
          and hosted on 
          <a href={footer.hosting.url} target="_blank" rel="noopener noreferrer" class="link link-accent hover:text-glow-cyan">{footer.hosting.name}</a>.
          <span class="hidden sm:inline">
            This site is open source on 
            <a 
              href={footer.repository.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="link link-accent hover:text-glow-cyan"
            >
              GitHub
            </a>.
          </span>
        </p>
        <p class="mt-1">
          Theme inspired by 
          <a 
            href="https://marketplace.visualstudio.com/items?itemName=RobbOwen.synthwave-vscode" 
            target="_blank" 
            rel="noopener noreferrer"
            class="link link-accent hover:text-glow-pink"
          >
            VS Code's Synthwave '84
          </a>
        </p>
      </div>
      <div class="badge badge-outline badge-xs opacity-60 shrink-0">
        v2025.01.{new Date().getDate().toString().padStart(2, '0')}.1
      </div>
    </div>
  </div>
</footer>