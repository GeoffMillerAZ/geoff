---
// Footer component with social links and site information
---

<footer class="mt-12 py-8 border-t border-synth-border">
  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Brand Section -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold text-glow">Geoffrey Miller</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Infrastructure Director & Principal Cloud Architect specializing in platform engineering, 
          cloud architecture, and AI-driven development workflows.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-accent uppercase tracking-wider">Quick Links</h4>
        <nav class="space-y-2">
          <a href="/blog" class="block text-sm text-gray-300 hover:text-white transition-colors">Blog</a>
          <a href="/projects" class="block text-sm text-gray-300 hover:text-white transition-colors">Projects</a>
          <a href="/guides" class="block text-sm text-gray-300 hover:text-white transition-colors">Guides</a>
          <a href="/resources" class="block text-sm text-gray-300 hover:text-white transition-colors">Resources</a>
          <a href="/contact" class="block text-sm text-gray-300 hover:text-white transition-colors">Contact</a>
        </nav>
      </div>

      <!-- Social Links -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold text-accent uppercase tracking-wider">Connect</h4>
        <div class="flex space-x-4">
          <a 
            href="https://github.com/GeoffMillerAZ" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-accent transition-colors"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a 
            href="https://linkedin.com/in/geoff-e-miller" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-accent transition-colors"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
        <div class="text-sm text-gray-400">
          <p>Phoenix, AZ</p>
          <p class="mt-1">
            Contact via 
            <a 
              href="https://linkedin.com/in/geoff-e-miller" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-accent hover:text-white font-medium transition-colors"
            >
              LinkedIn
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="mt-8 pt-8 border-t border-synth-border">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <div class="text-xs text-gray-500 text-center md:text-left">
          <p>
            © {new Date().getFullYear()} Geoffrey Miller. Built with 
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-white transition-colors">Astro</a>
            and hosted on 
            <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-white transition-colors">Vercel</a>.
          </p>
          <p class="mt-1">
            This site is open source on 
            <a 
              href="https://github.com/GeoffMillerAZ/geoff" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-accent hover:text-white transition-colors"
            >
              GitHub
            </a>.
          </p>
        </div>
        <div class="text-xs text-gray-500">
          Version 2025.01.{new Date().getDate().toString().padStart(2, '0')}.1
        </div>
      </div>
    </div>
  </div>
</footer>