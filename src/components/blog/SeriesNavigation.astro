---
import { getCollection } from 'astro:content';

export interface Props {
  series: {
    name: string;
    order: number;
    next?: string;
    previous?: string;
  };
  currentSlug: string;
}

const { series, currentSlug } = Astro.props;

// Get all posts in the same series
const allPosts = await getCollection('blog');
const seriesPosts = allPosts
  .filter(post => post.data.series?.name === series.name)
  .sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));

// Build navigation data
const currentIndex = seriesPosts.findIndex(post => post.slug === currentSlug);
const previousPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
---

<div class="series-navigation card p-6 mb-8">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-glow">
      {series.name}
    </h3>
    <span class="text-sm text-synth-text-muted">
      Part {series.order} of {seriesPosts.length}
    </span>
  </div>
  
  <!-- Series Overview -->
  <div class="mb-6">
    <h4 class="text-sm font-medium text-synth-text mb-3">Series Contents:</h4>
    <ol class="space-y-2">
      {seriesPosts.map((post, index) => (
        <li class="flex items-start gap-2">
          <span class="text-xs text-synth-text-muted mt-0.5">{index + 1}.</span>
          {post.slug === currentSlug ? (
            <span class="text-sm font-medium text-accent">
              {post.data.title} (Current)
            </span>
          ) : (
            <a 
              href={`/blog/${post.slug}`}
              class="text-sm text-synth-text hover:text-accent transition-colors"
            >
              {post.data.title}
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
  
  <!-- Navigation Links -->
  <div class="flex justify-between items-center pt-4 border-t border-synth-border">
    {previousPost ? (
      <a 
        href={`/blog/${previousPost.slug}`}
        class="flex items-center gap-2 text-sm text-synth-text hover:text-accent transition-colors group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>Previous: {previousPost.data.title}</span>
      </a>
    ) : (
      <div></div>
    )}
    
    {nextPost ? (
      <a 
        href={`/blog/${nextPost.slug}`}
        class="flex items-center gap-2 text-sm text-synth-text hover:text-accent transition-colors group"
      >
        <span>Next: {nextPost.data.title}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    ) : (
      <div></div>
    )}
  </div>
</div>

<style>
  .series-navigation {
    background: linear-gradient(135deg, rgba(249, 42, 173, 0.05) 0%, rgba(37, 176, 188, 0.05) 100%);
  }
</style>