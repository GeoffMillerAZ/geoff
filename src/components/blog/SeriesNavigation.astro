---
import { getCollection } from 'astro:content';

export interface Props {
  series: {
    name: string;
    order: number;
    next?: string;
    previous?: string;
  };
  currentSlug: string;
}

const { series, currentSlug } = Astro.props;

// Get all posts in the same series
const allPosts = await getCollection('blog');
const seriesPosts = allPosts
  .filter(post => post.data.series?.name === series.name)
  .sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));

// Build navigation data
const currentIndex = seriesPosts.findIndex(post => post.slug === currentSlug);
const previousPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
---

<div class="card bg-base-100 shadow-xl p-6 mb-8 border border-accent/30">
  <div class="card-body p-0">
    <div class="flex items-center justify-between mb-4">
      <h3 class="card-title text-lg text-glow">
        <span class="badge badge-accent badge-sm mr-2">Series</span>
        {series.name}
      </h3>
      <div class="badge badge-outline">
        Part {series.order} of {seriesPosts.length}
      </div>
    </div>
    
    <!-- Series Overview -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-base-content mb-3">Series Contents:</h4>
      <div class="steps steps-vertical">
        {seriesPosts.map((post, index) => (
          <div class={`step ${index + 1 <= series.order ? 'step-primary' : ''}`}>
            {post.slug === currentSlug ? (
              <span class="text-sm font-medium text-primary">
                {post.data.title}
                <div class="badge badge-primary badge-xs ml-2">Current</div>
              </span>
            ) : (
              <a 
                href={`/blog/${post.slug}`}
                class="link link-hover text-sm hover:text-primary transition-colors"
              >
                {post.data.title}
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
    
    <!-- Navigation Links -->
    <div class="card-actions justify-between pt-4 border-t border-base-300">
      {previousPost ? (
        <a 
          href={`/blog/${previousPost.slug}`}
          class="btn btn-outline btn-sm gap-2 group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Previous
        </a>
      ) : (
        <div></div>
      )}
      
      {nextPost ? (
        <a 
          href={`/blog/${nextPost.slug}`}
          class="btn btn-primary btn-sm gap-2 group"
        >
          Next
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      ) : (
        <div></div>
      )}
    </div>
  </div>
</div>

