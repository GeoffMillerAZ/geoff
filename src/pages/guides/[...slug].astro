---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/navigation/Footer.astro';

export async function getStaticPaths() {
  const guideEntries = await getCollection('guides');
  return guideEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'guides'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

// Get related guides (same category, excluding current guide)
const allGuides = await getCollection('guides');
const relatedGuides = allGuides
  .filter(guide => guide.data.category === entry.data.category && guide.slug !== entry.slug)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .slice(0, 3);

const publishDate = new Date(entry.data.publishDate);
const readingTime = Math.ceil(entry.body.split(' ').length / 200);

// Category metadata
const categoryMeta = {
  'platform-engineering': {
    title: 'Platform Engineering',
    icon: '🏗️',
    color: 'from-blue-500/20 to-cyan-500/20'
  },
  'architectural-decisions': {
    title: 'Architectural Decisions',
    icon: '🏛️',
    color: 'from-purple-500/20 to-pink-500/20'
  },
  'best-practices': {
    title: 'Best Practices',
    icon: '⭐',
    color: 'from-yellow-500/20 to-orange-500/20'
  },
  'frameworks': {
    title: 'Frameworks',
    icon: '🔧',
    color: 'from-green-500/20 to-emerald-500/20'
  }
};

const currentCategoryMeta = categoryMeta[entry.data.category as keyof typeof categoryMeta];
---

<BaseLayout 
  title={`${entry.data.title} | Geoffrey Miller Platform Engineering Guides`}
  description={entry.data.description}
  canonical={`/guides/${entry.slug}`}
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-5xl">
    <!-- Breadcrumbs -->
    <nav class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-synth-text-muted">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li class="before:content-['/'] before:mx-2">
          <a href="/guides" class="hover:text-accent transition-colors">Guides</a>
        </li>
        <li class="before:content-['/'] before:mx-2 text-synth-text truncate">
          {entry.data.title}
        </li>
      </ol>
    </nav>

    <!-- Guide Header -->
    <header class="mb-12">
      <div class={`card p-8 bg-gradient-to-br ${currentCategoryMeta?.color || 'from-accent/5 to-accent-dark/5'} border-accent/20`}>
        <!-- Category Badge -->
        <div class="flex items-center gap-4 mb-6">
          <span class="text-3xl">{currentCategoryMeta?.icon || '📖'}</span>
          <div>
            <span class="px-4 py-2 text-sm font-medium rounded-full bg-accent/20 text-accent border border-accent/30">
              {currentCategoryMeta?.title || entry.data.category.replace('-', ' ')}
            </span>
            <div class="flex items-center gap-4 mt-2">
              <time class="text-sm text-synth-text-muted">
                {formatDate(publishDate)}
              </time>
              <span class="text-sm text-synth-text-muted">
                {readingTime} min read
              </span>
              <span class="text-sm text-synth-text-muted">
                Implementation Guide
              </span>
            </div>
          </div>
        </div>

        <!-- Title and Description -->
        <h1 class="text-4xl md:text-5xl font-bold text-glow mb-6 leading-tight">
          {entry.data.title}
        </h1>

        <p class="text-xl text-synth-text leading-relaxed mb-6">
          {entry.data.description}
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {entry.data.tags.map((tag: string) => (
            <span class="px-3 py-1 text-sm rounded-full bg-white/10 text-synth-text border border-white/20">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Guide Difficulty & Prerequisites (if applicable) -->
        <div class="grid md:grid-cols-2 gap-4 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="text-synth-text-muted">Practical Implementation Focus</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-synth-text-muted">Battle-tested Approach</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Table of Contents (if the guide has headers) -->
    <aside class="mb-12">
      <div class="card p-6 bg-synth-card-bg/50">
        <h2 class="font-semibold text-accent mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          Guide Overview
        </h2>
        <p class="text-sm text-synth-text-muted mb-3">
          This guide provides a comprehensive framework with practical implementation steps, 
          real-world examples, and actionable takeaways you can apply immediately.
        </p>
        <div class="text-sm text-synth-text">
          <span class="font-medium">What you'll learn:</span> Industry-proven approaches, common pitfalls to avoid, 
          and step-by-step implementation guidance.
        </div>
      </div>
    </aside>

    <!-- Guide Content -->
    <article class="prose prose-lg prose-invert max-w-none mb-12">
      <div class="card p-8">
        <Content />
      </div>
    </article>

    <!-- AI Summary Section (if available) -->
    {entry.data.aiSummary && (
      <section class="mb-12">
        <div class="card p-6 bg-gradient-to-r from-accent/5 to-accent-dark/5 border-accent/20">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center mt-1">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-accent mb-3">Key Takeaways</h3>
              <p class="text-synth-text leading-relaxed">
                {entry.data.aiSummary}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Implementation Checklist (Placeholder) -->
    <section class="mb-12">
      <div class="card p-6 border-accent/20">
        <h3 class="font-semibold text-glow mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          Quick Implementation Checklist
        </h3>
        <p class="text-sm text-synth-text-muted mb-4">
          Use this checklist to track your progress implementing the concepts from this guide:
        </p>
        <div class="grid md:grid-cols-2 gap-3 text-sm">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="w-4 h-4 text-accent rounded border-synth-border focus:ring-accent/50">
            <span class="text-synth-text">Review current state assessment</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="w-4 h-4 text-accent rounded border-synth-border focus:ring-accent/50">
            <span class="text-synth-text">Identify key stakeholders</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="w-4 h-4 text-accent rounded border-synth-border focus:ring-accent/50">
            <span class="text-synth-text">Define success metrics</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="w-4 h-4 text-accent rounded border-synth-border focus:ring-accent/50">
            <span class="text-synth-text">Create implementation timeline</span>
          </label>
        </div>
      </div>
    </section>

    <!-- Share Section -->
    <section class="mb-12">
      <div class="card p-6">
        <h3 class="font-semibold text-glow mb-4">Share this guide</h3>
        <div class="flex flex-wrap gap-3">
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${entry.data.title} - A comprehensive platform engineering guide`)}&url=${encodeURIComponent(`https://geoffmiller.dev/guides/${entry.slug}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-sm"
          >
            Share on Twitter
          </a>
          <a 
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://geoffmiller.dev/guides/${entry.slug}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-sm"
          >
            Share on LinkedIn
          </a>
          <button 
            onclick={`navigator.clipboard.writeText('https://geoffmiller.dev/guides/${entry.slug}')`}
            class="btn-secondary text-sm"
          >
            Copy Link
          </button>
        </div>
      </div>
    </section>

    <!-- Related Guides -->
    {relatedGuides.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-glow mb-8">Related Guides</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedGuides.map((guide) => {
            const guideMeta = categoryMeta[guide.data.category as keyof typeof categoryMeta];
            return (
              <article class="card p-6 hover:border-accent transition-colors">
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-xl">{guideMeta?.icon || '📖'}</span>
                  <div>
                    <span class="px-2 py-1 text-xs font-medium rounded bg-accent/20 text-accent">
                      {guideMeta?.title || guide.data.category}
                    </span>
                    <time class="block text-xs text-synth-text-muted mt-1">
                      {formatDate(new Date(guide.data.publishDate))}
                    </time>
                  </div>
                </div>
                
                <h3 class="font-bold text-glow mb-3 text-lg leading-tight hover:text-accent transition-colors">
                  <a href={`/guides/${guide.slug}`}>
                    {guide.data.title}
                  </a>
                </h3>
                
                <p class="text-synth-text-muted text-sm mb-4 leading-relaxed line-clamp-3">
                  {guide.data.description}
                </p>
                
                <a 
                  href={`/guides/${guide.slug}`} 
                  class="inline-flex items-center text-accent hover:text-accent-light transition-colors text-sm font-medium"
                >
                  Read guide
                  <svg class="ml-1 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- Back to Guides -->
    <section class="text-center">
      <a href="/guides" class="btn-secondary">
        ← Back to All Guides
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Enhanced prose styles for guides */
  .prose {
    color: var(--synth-text);
  }
  
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: var(--synth-glow-text);
    text-shadow: 0 0 7px var(--synth-pink);
  }
  
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .prose h2::before {
    content: "";
    width: 0.25rem;
    height: 1.5rem;
    background-color: var(--synth-pink);
    border-radius: 9999px;
  }
  
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  
  .prose a {
    color: var(--synth-pink);
    transition: color 0.2s ease-in-out;
    text-decoration: underline;
    text-decoration-color: rgba(249, 42, 173, 0.3);
  }
  
  .prose a:hover {
    color: rgba(249, 42, 173, 0.8);
    text-decoration-color: var(--synth-pink);
  }
  
  .prose blockquote {
    border-left: 4px solid var(--synth-pink);
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    font-style: italic;
    color: rgba(229, 229, 229, 0.7);
    background-color: rgba(249, 42, 173, 0.05);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  
  .prose code {
    background-color: var(--synth-card-bg);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--synth-pink);
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
  }
  
  .prose pre {
    background-color: var(--synth-card-bg);
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--synth-border);
    overflow-x: auto;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: var(--synth-text);
  }
  
  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  
  .prose li {
    margin-bottom: 0.5rem;
  }
  
  .prose li::marker {
    color: var(--synth-pink);
  }
  
  .prose table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--synth-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  
  .prose th, .prose td {
    border-right: 1px solid var(--synth-border);
    padding: 0.75rem 1rem;
  }
  
  .prose th {
    background-color: var(--synth-card-bg);
    font-weight: 600;
    color: var(--synth-pink);
  }
  
  .prose tr:nth-child(even) {
    background-color: rgba(20, 10, 30, 0.15);
  }
  
  .prose img {
    border-radius: 0.5rem;
    border: 1px solid var(--synth-border);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
  
  /* Special styling for implementation steps */
  .prose .implementation-step {
    padding: 1rem;
    border-left: 4px solid var(--synth-pink);
    background-color: rgba(249, 42, 173, 0.05);
    border-radius: 0 0.5rem 0.5rem 0;
    margin-bottom: 1rem;
  }
</style>

<!-- JSON-LD Structured Data for Guide -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": entry.data.title,
  "description": entry.data.description,
  "author": {
    "@type": "Person",
    "name": "Geoffrey Miller",
    "url": "https://geoffmiller.dev",
    "jobTitle": "Infrastructure Director & Principal Cloud Architect"
  },
  "datePublished": entry.data.publishDate,
  "dateModified": entry.data.publishDate,
  "publisher": {
    "@type": "Person",
    "name": "Geoffrey Miller"
  },
  "url": `https://geoffmiller.dev/guides/${entry.slug}`,
  "keywords": entry.data.tags.join(", "),
  "articleSection": "Platform Engineering Guide",
  "wordCount": entry.body.split(' ').length,
  "timeRequired": `PT${readingTime}M`,
  "learningResourceType": "Guide",
  "educationalLevel": "Professional",
  "about": {
    "@type": "Thing",
    "name": currentCategoryMeta?.title || entry.data.category
  }
})} />