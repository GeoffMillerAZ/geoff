---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/navigation/Footer.astro';

// Get all guides
const allGuides = await getCollection('guides');

// Sort guides by publish date (newest first)
const sortedGuides = allGuides.sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);

// Group guides by category
const categories = [...new Set(allGuides.map(guide => guide.data.category))];
const guidesByCategory = categories.reduce((acc, category) => {
  acc[category] = sortedGuides.filter(guide => guide.data.category === category);
  return acc;
}, {} as Record<string, typeof sortedGuides>);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

// Define category metadata
const categoryMeta = {
  'platform-engineering': {
    title: 'Platform Engineering',
    description: 'Building internal developer platforms that scale',
    icon: '🏗️'
  },
  'architectural-decisions': {
    title: 'Architectural Decisions',
    description: 'Framework for making sound technical choices',
    icon: '🏛️'
  },
  'best-practices': {
    title: 'Best Practices',
    description: 'Battle-tested approaches for production systems',
    icon: '⭐'
  },
  'frameworks': {
    title: 'Frameworks',
    description: 'Structured approaches to complex problems',
    icon: '🔧'
  }
};
---

<BaseLayout 
  title="Guides | Geoffrey Miller - Platform Engineering & Cloud Architecture Frameworks"
  description="Comprehensive guides on platform engineering, cloud architecture, and technical leadership. Battle-tested frameworks and best practices from 12+ years in the field."
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="card bg-base-100 shadow-xl p-8 text-center">
        <h1 class="text-4xl font-bold text-glow mb-4">Platform Engineering Guides</h1>
        <p class="text-xl text-base-content opacity-70 max-w-4xl mx-auto">
          Comprehensive frameworks, best practices, and battle-tested approaches for building 
          and operating cloud platforms at scale. Distilled from real-world experience across 
          multiple organizations and industries.
        </p>
      </div>
    </section>

    {sortedGuides.length > 0 ? (
      <>
        <!-- Featured Guide -->
        {sortedGuides[0] && (
          <section class="mb-16">
            <h2 class="text-2xl font-bold text-glow mb-6">Featured Guide</h2>
            <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 p-8">
              <div class="flex flex-col lg:flex-row gap-8">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-6">
                    <span class="text-2xl">
                      {categoryMeta[sortedGuides[0].data.category as keyof typeof categoryMeta]?.icon || '📖'}
                    </span>
                    <div>
                      <div class="badge badge-primary">
                      {categoryMeta[sortedGuides[0].data.category as keyof typeof categoryMeta]?.title || sortedGuides[0].data.category}
                      </div>
                      <time class="block text-sm text-base-content opacity-70 mt-1">
                      {formatDate(new Date(sortedGuides[0].data.publishDate))}
                      </time>
                    </div>
                  </div>
                  
                  <h3 class="card-title text-3xl text-glow mb-4 hover:text-primary transition-colors">
                    <a href={`/guides/${sortedGuides[0].slug}`}>
                      {sortedGuides[0].data.title}
                    </a>
                  </h3>
                  
                  <p class="text-base-content mb-6 leading-relaxed text-lg">
                    {sortedGuides[0].data.description}
                  </p>
                  
                  <div class="flex flex-wrap gap-2 mb-6">
                    {sortedGuides[0].data.tags.map((tag: string) => (
                      <div class="badge badge-outline">
                        #{tag}
                      </div>
                    ))}
                  </div>
                  
                  <a 
                    href={`/guides/${sortedGuides[0].slug}`} 
                    class="btn btn-primary inline-flex items-center"
                  >
                    Read Guide
                    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          </section>
        )}

        <!-- Guides by Category -->
        <section>
          <h2 class="text-2xl font-bold text-glow mb-8">All Guides</h2>
          
          {Object.entries(guidesByCategory).map(([category, guides]) => {
            const meta = categoryMeta[category as keyof typeof categoryMeta];
            return (
              <div class="mb-12">
                <div class="flex items-center gap-4 mb-8">
                <span class="text-3xl">{meta?.icon || '📖'}</span>
                <div>
                <h3 class="text-xl font-bold text-primary">
                {meta?.title || category.replace('-', ' ')}
                </h3>
                <p class="text-base-content opacity-70 text-sm">
                {meta?.description || `${guides.length} guides available`}
                </p>
                </div>
                <div class="ml-auto">
                <div class="badge badge-primary">
                {guides.length} {guides.length === 1 ? 'guide' : 'guides'}
                </div>
                </div>
                </div>
                
                <div class="grid md:grid-cols-2 gap-6">
                  {guides.map((guide) => (
                    <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 group p-6">
                      <div class="flex items-start justify-between mb-4">
                        <time class="text-sm text-base-content opacity-70">
                          {formatDate(new Date(guide.data.publishDate))}
                        </time>
                        <div class="w-2 h-2 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                      </div>
                      
                      <h4 class="card-title text-xl text-glow mb-3 hover:text-primary transition-colors leading-tight">
                        <a href={`/guides/${guide.slug}`}>
                          {guide.data.title}
                        </a>
                      </h4>
                      
                      <p class="text-base-content mb-4 leading-relaxed">
                        {guide.data.description}
                      </p>
                      
                      <div class="flex flex-wrap items-center justify-between gap-4">
                        <div class="flex flex-wrap gap-2">
                          {guide.data.tags.slice(0, 2).map((tag: string) => (
                            <div class="badge badge-outline badge-sm">
                              {tag}
                            </div>
                          ))}
                          {guide.data.tags.length > 2 && (
                            <div class="badge badge-ghost badge-sm">
                              +{guide.data.tags.length - 2}
                            </div>
                          )}
                        </div>
                        
                        <a 
                          href={`/guides/${guide.slug}`} 
                          class="btn btn-primary btn-sm btn-outline"
                        >
                          Read guide
                          <svg class="ml-1 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                          </svg>
                        </a>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            );
          })}
        </section>
      </>
    ) : (
      <!-- Empty state -->
      <section class="text-center py-16">
        <div class="card bg-base-100 shadow-xl p-12">
          <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-primary bg-opacity-20 border border-primary border-opacity-30 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-glow mb-4">Comprehensive Guides Coming Soon</h2>
          <p class="text-base-content opacity-70 mb-8 max-w-2xl mx-auto leading-relaxed">
            I'm developing in-depth guides covering platform engineering frameworks, 
            architectural decision-making processes, and best practices for building 
            scalable cloud platforms. These will be comprehensive resources based on 
            real-world experience and battle-tested approaches.
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            {Object.entries(categoryMeta).map(([key, meta]) => (
              <div class="card bg-base-200 shadow p-4 text-center">
                <div class="text-2xl mb-2">{meta.icon}</div>
                <h3 class="font-semibold text-primary mb-1 text-sm">{meta.title}</h3>
                <p class="text-xs text-base-content opacity-70">{meta.description}</p>
              </div>
            ))}
          </div>
          <a href="/" class="btn btn-primary">
            Back to Home
          </a>
        </div>
      </section>
    )}

    <!-- Guide Categories Overview -->
    <section class="mt-16">
      <div class="card bg-base-100 shadow-xl p-8">
        <h2 class="text-2xl font-bold text-glow mb-6 text-center">What You'll Find Here</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {Object.entries(categoryMeta).map(([key, meta]) => (
            <div class="text-center">
              <div class="text-3xl mb-3">{meta.icon}</div>
              <h3 class="font-semibold text-primary mb-2">{meta.title}</h3>
              <p class="text-sm text-base-content opacity-70 leading-relaxed">
                {meta.description}
              </p>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <p class="text-base-content opacity-70 mb-4">
            Each guide provides actionable frameworks, real-world examples, and practical implementation steps.
          </p>
          <a href="/blog" class="link link-primary font-medium">
            Also check out the technical blog →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .text-glow {
    text-shadow: 0 0 10px #f92aad;
  }
</style>