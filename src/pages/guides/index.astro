---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/navigation/Footer.astro';
import { getEnabledGuideSections } from '../../config/site.config';

// Get all guides
const allGuides = await getCollection('guides');

// Sort guides by publish date (newest first)
const sortedGuides = allGuides.sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);

// Group guides by category
const categories = [...new Set(allGuides.map(guide => guide.data.category))];
const guidesByCategory = categories.reduce((acc, category) => {
  acc[category] = sortedGuides.filter(guide => guide.data.category === category);
  return acc;
}, {} as Record<string, typeof sortedGuides>);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

// Get enabled guide sections from config
const guideSections = getEnabledGuideSections();

// Define category metadata
const categoryMeta = {
  'platform-engineering': {
    title: 'Platform Engineering',
    description: 'Building internal developer platforms that scale',
    icon: '🏗️'
  },
  'infrastructure': {
    title: 'Infrastructure',
    description: 'Cloud infrastructure and automation',
    icon: '☁️'
  },
  'cloud-native': {
    title: 'Cloud Native',
    description: 'Kubernetes, containers, and microservices',
    icon: '🚀'
  },
  'devops': {
    title: 'DevOps',
    description: 'CI/CD, automation, and operational excellence',
    icon: '♾️'
  },
  'context-engineering': {
    title: 'Context Engineering',
    description: 'AI-ready documentation and architecture',
    icon: '🧠'
  },
  'ai-architecture': {
    title: 'AI Architecture',
    description: 'Building AI-consumable systems',
    icon: '🤖'
  },
  'knowledge-management': {
    title: 'Knowledge Management',
    description: 'Structured information architecture',
    icon: '📚'
  },
  'semantic-design': {
    title: 'Semantic Design',
    description: 'Meaningful, machine-readable structures',
    icon: '🔮'
  },
  'mlops': {
    title: 'MLOps',
    description: 'Machine learning operations at scale',
    icon: '⚙️'
  },
  'model-deployment': {
    title: 'Model Deployment',
    description: 'Deploying ML models to production',
    icon: '🚀'
  },
  'ml-infrastructure': {
    title: 'ML Infrastructure',
    description: 'Infrastructure for machine learning workloads',
    icon: '🏭'
  },
  'feature-engineering': {
    title: 'Feature Engineering',
    description: 'Building robust feature pipelines',
    icon: '🔧'
  }
};
---

<BaseLayout 
  title="Guides | Geoffrey Miller - Platform Engineering & Cloud Architecture Frameworks"
  description="Comprehensive guides on platform engineering, cloud architecture, and technical leadership. Battle-tested frameworks and best practices from 12+ years in the field."
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="card bg-base-100 shadow-xl p-8 text-center">
        <h1 class="text-4xl font-bold text-glow mb-4">Engineering Guides</h1>
        <p class="text-xl text-base-content opacity-70 max-w-4xl mx-auto mb-8">
          Comprehensive frameworks for platform engineering and context engineering. 
          Battle-tested approaches for building scalable systems and AI-ready architectures.
        </p>
        
        <!-- Section Overview -->
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {Object.entries(guideSections).map(([key, section]) => (
            <div class="card bg-base-200 shadow-lg p-6 text-left">
              <div class="flex items-start gap-4">
                <span class="text-3xl">{section.icon}</span>
                <div class="flex-1">
                  <h2 class="text-lg font-bold text-primary mb-2">{section.title}</h2>
                  <p class="text-sm text-base-content opacity-70 leading-relaxed">
                    {section.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {sortedGuides.length > 0 ? (
      <>
        <!-- Guides by Section -->
        <section>
          {Object.entries(guideSections).map(([sectionKey, section]) => {
            // Filter guides that belong to this section's categories
            const sectionGuides = sortedGuides.filter(guide => 
              section.categories.includes(guide.data.category)
            );
            
            return (
              <div class="mb-16">
                <div class="divider divider-primary mb-8">
                  <div class="flex items-center gap-4">
                    <span class="text-4xl">{section.icon}</span>
                    <div>
                      <h2 class="text-2xl font-bold text-glow">{section.title}</h2>
                      <p class="text-sm text-base-content opacity-70 mt-1">{section.description}</p>
                    </div>
                  </div>
                </div>
                
                {sectionGuides.length > 0 ? (
                  <div class="grid md:grid-cols-2 gap-6">
                    {sectionGuides.map((guide) => (
                    <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 group p-6">
                      <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-2">
                          <div class="badge badge-outline badge-sm">
                            {categoryMeta[guide.data.category as keyof typeof categoryMeta]?.title || guide.data.category}
                          </div>
                          <time class="text-sm text-base-content opacity-70">
                            {formatDate(new Date(guide.data.publishDate))}
                          </time>
                        </div>
                        <div class="w-2 h-2 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                      </div>
                      
                      <h4 class="card-title text-xl text-glow mb-3 hover:text-primary transition-colors leading-tight">
                        <a href={`/guides/${guide.slug}`}>
                          {guide.data.title}
                        </a>
                      </h4>
                      
                      <p class="text-base-content mb-4 leading-relaxed">
                        {guide.data.description}
                      </p>
                      
                      <div class="flex flex-wrap items-center justify-between gap-4">
                        <div class="flex flex-wrap gap-2">
                          {guide.data.tags.slice(0, 2).map((tag: string) => (
                            <div class="badge badge-outline badge-sm">
                              {tag}
                            </div>
                          ))}
                          {guide.data.tags.length > 2 && (
                            <div class="badge badge-ghost badge-sm">
                              +{guide.data.tags.length - 2}
                            </div>
                          )}
                        </div>
                        
                        <a 
                          href={`/guides/${guide.slug}`} 
                          class="btn btn-primary btn-sm btn-outline"
                        >
                          Read guide
                          <svg class="ml-1 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                          </svg>
                        </a>
                      </div>
                    </article>
                  ))}
                  </div>
                ) : (
                  <div class="card bg-base-200 p-8 text-center">
                    <p class="text-base-content opacity-70">
                      {section.title} guides coming soon. These will cover {section.description.toLowerCase()}.
                    </p>
                  </div>
                )}
              </div>
            );
          })}
        </section>
      </>
    ) : (
      <!-- Empty state -->
      <section class="text-center py-16">
        <!-- What You'll Find Here (shown when no guides exist) -->
        <div class="card bg-base-100 shadow-xl p-8 mb-8">
          <h2 class="text-2xl font-bold text-glow mb-8 text-center">What's Coming Soon</h2>
          
          <!-- Platform Engineering Topics (if enabled) -->
          {guideSections.platformEngineering && (
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
                <span class="text-3xl">{guideSections.platformEngineering.icon}</span>
                <h3 class="text-xl font-bold text-primary">Platform Engineering Guides</h3>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Internal Developer Platforms</h4>
                  <p class="text-sm text-base-content opacity-70">Building self-service platforms that empower development teams</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Infrastructure as Code</h4>
                  <p class="text-sm text-base-content opacity-70">Terraform, Pulumi, and GitOps workflows at scale</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Kubernetes Patterns</h4>
                  <p class="text-sm text-base-content opacity-70">Production-ready patterns for container orchestration</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">CI/CD Pipelines</h4>
                  <p class="text-sm text-base-content opacity-70">Building reliable, fast deployment pipelines</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Observability Stack</h4>
                  <p class="text-sm text-base-content opacity-70">Metrics, logs, and traces for production systems</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Cost Optimization</h4>
                  <p class="text-sm text-base-content opacity-70">FinOps practices and cloud cost management</p>
                </div>
              </div>
            </div>
          )}
          
          <!-- Context Engineering Topics (if enabled) -->
          {guideSections.contextEngineering && (
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
                <span class="text-3xl">{guideSections.contextEngineering.icon}</span>
                <h3 class="text-xl font-bold text-primary">Context Engineering Guides</h3>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">AI-Ready Documentation</h4>
                  <p class="text-sm text-base-content opacity-70">Structuring docs for LLM consumption and understanding</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Semantic Architecture</h4>
                  <p class="text-sm text-base-content opacity-70">Building systems with meaningful, machine-readable structures</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Knowledge Graphs</h4>
                  <p class="text-sm text-base-content opacity-70">Connecting information for better AI comprehension</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Context Windows</h4>
                  <p class="text-sm text-base-content opacity-70">Optimizing information density for LLM interactions</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Prompt Engineering</h4>
                  <p class="text-sm text-base-content opacity-70">System prompts and context management strategies</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">RAG Architectures</h4>
                  <p class="text-sm text-base-content opacity-70">Retrieval-augmented generation patterns</p>
                </div>
              </div>
            </div>
          )}
          
          <!-- MLOps Topics (if enabled) -->
          {guideSections.mlops && (
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
                <span class="text-3xl">{guideSections.mlops.icon}</span>
                <h3 class="text-xl font-bold text-primary">MLOps Guides</h3>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Model Versioning</h4>
                  <p class="text-sm text-base-content opacity-70">Managing ML model versions and reproducibility</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Training Pipelines</h4>
                  <p class="text-sm text-base-content opacity-70">Building scalable, automated training workflows</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Model Serving</h4>
                  <p class="text-sm text-base-content opacity-70">Deploying models with low latency and high availability</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Feature Stores</h4>
                  <p class="text-sm text-base-content opacity-70">Centralized feature management and serving</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Model Monitoring</h4>
                  <p class="text-sm text-base-content opacity-70">Detecting drift and maintaining model performance</p>
                </div>
                <div class="card bg-base-200 p-4 text-left">
                  <h4 class="font-semibold mb-2">Experiment Tracking</h4>
                  <p class="text-sm text-base-content opacity-70">Managing ML experiments and hyperparameters</p>
                </div>
              </div>
            </div>
          )}
          
          <div class="text-center">
            <a href="/" class="btn btn-primary">
              Back to Home
            </a>
          </div>
        </div>
      </section>
    )}

  </main>

  <Footer />
</BaseLayout>

<style>
  .text-glow {
    text-shadow: 0 0 10px #f92aad;
  }
</style>