---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
---

<BaseLayout 
  title="Contact | Geoffrey Miller - Let's Discuss Platform Engineering"
  description="Get in touch with Geoffrey Miller to discuss platform engineering, cloud architecture, technical leadership, or collaboration opportunities."
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="card bg-base-100 shadow-xl p-8 text-center">
        <h1 class="text-4xl font-bold text-glow mb-4">Let's Connect</h1>
        <p class="text-xl text-base-content opacity-70 max-w-3xl mx-auto">
          I'm always interested in discussing platform engineering challenges, sharing experiences, 
          or exploring collaboration opportunities on interesting technical problems.
        </p>
      </div>
    </section>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- LinkedIn Contact CTA -->
      <section>
        <div class="card bg-base-100 shadow-xl p-8 text-center">
          <h2 class="text-2xl font-bold text-glow mb-6">Connect on LinkedIn</h2>
          <p class="text-base-content mb-8">
            The best way to reach me is through LinkedIn. I'm active on the platform and typically respond within 1-2 business days.
          </p>
          <a 
            href="https://linkedin.com/in/geoff-e-miller" 
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg gap-3 group"
          >
            <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            Send Me a Message on LinkedIn
          </a>
          <p class="text-sm text-base-content opacity-70 mt-6">
            Please mention how you found my website and what you'd like to discuss.
          </p>
        </div>
        
        <!-- What to Include in Your Message -->
        <div class="card bg-base-100 shadow-xl p-6 mt-8">
          <h3 class="text-xl font-bold text-glow mb-4">What to Include in Your Message</h3>
          <ul class="space-y-3 text-sm text-base-content">
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              <span><strong>Context:</strong> A brief introduction and how you found me</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              <span><strong>Purpose:</strong> What you'd like to discuss or achieve</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              <span><strong>Timeline:</strong> Any relevant deadlines or timeframes</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              <span><strong>Specifics:</strong> Any particular areas of expertise you're interested in</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Contact Information -->
      <section class="space-y-8">
        <!-- Location -->
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-xl font-bold text-glow mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Location
          </h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-base-content">Arizona, United States</span>
            </div>
            <p class="text-sm text-base-content opacity-70">
              Available for remote collaborations globally and in-person meetings in the Phoenix metro area.
            </p>
          </div>
        </div>

        <!-- Social Links -->
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-xl font-bold text-glow mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            Connect on Social
          </h3>
          <div class="space-y-3">
            <a 
              href="https://linkedin.com/in/geoff-e-miller" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-base-content hover:text-primary transition-colors group"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <div>
                <div class="font-medium">LinkedIn</div>
                <div class="text-sm text-base-content opacity-70">Professional networking</div>
              </div>
            </a>
            
            <a 
              href="https://github.com/GeoffMillerAZ" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-base-content hover:text-primary transition-colors group"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.374 0 0 5.373 0 12 0 17.302 3.438 21.8 8.207 23.387c.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              <div>
                <div class="font-medium">GitHub</div>
                <div class="text-sm text-base-content opacity-70">Open source projects</div>
              </div>
            </a>
          </div>
        </div>

        <!-- Response Time -->
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-xl font-bold text-glow mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Response Time
          </h3>
          <div class="space-y-2 text-sm text-base-content">
            <p>
              <span class="font-medium text-primary">LinkedIn:</span> Usually within 1-2 business days
            </p>
            <p>
              <span class="font-medium text-primary">Speaking/Consulting:</span> Within 48 hours for time-sensitive requests
            </p>
            <p class="text-base-content opacity-70 mt-3">
              For urgent platform engineering or infrastructure matters, please indicate 
              the urgency in your subject line.
            </p>
          </div>
        </div>

        <!-- What I Can Help With -->
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-xl font-bold text-glow mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            How I Can Help
          </h3>
          <ul class="space-y-2 text-sm text-base-content">
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Platform engineering architecture and strategy
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Cloud migration and modernization planning
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Kubernetes and container orchestration
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Developer experience and internal tooling
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Technical leadership and team building
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Conference speaking and technical writing
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Career mentoring and guidance
            </li>
          </ul>
        </div>
      </section>
    </div>

    <!-- FAQ Section -->
    <section class="mt-16">
      <div class="card bg-base-100 shadow-xl p-8">
        <h2 class="text-2xl font-bold text-glow mb-8 text-center">Frequently Asked Questions</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="font-semibold text-primary mb-2">Are you available for consulting?</h3>
            <p class="text-sm text-base-content mb-4">
              I occasionally take on strategic consulting engagements for platform engineering 
              and cloud architecture. Please reach out to discuss your specific needs and timeline.
            </p>
            
            <h3 class="font-semibold text-primary mb-2">Do you offer mentoring?</h3>
            <p class="text-sm text-base-content mb-4">
              Yes, I enjoy mentoring engineers looking to advance in platform engineering, 
              cloud architecture, or technical leadership roles. I offer both formal and 
              informal mentoring arrangements.
            </p>
          </div>
          
          <div>
            <h3 class="font-semibold text-primary mb-2">Can you speak at our event?</h3>
            <p class="text-sm text-base-content mb-4">
              I'm interested in speaking at conferences, meetups, and corporate events 
              about platform engineering, cloud architecture, and technical leadership. 
              Please include event details and timing in your message.
            </p>
            
            <h3 class="font-semibold text-primary mb-2">What's your response time?</h3>
            <p class="text-sm text-base-content">
              I aim to respond to all messages within 24-48 hours. For urgent matters, 
              please indicate the urgency in your subject line or reach out via LinkedIn 
              for faster response.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .text-glow {
    text-shadow: 0 0 10px #f92aad;
  }
</style>

<!-- JSON-LD Structured Data for Contact Page -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Geoffrey Miller",
  "description": "Get in touch with Geoffrey Miller for platform engineering, cloud architecture, and technical leadership discussions",
  "url": "https://geoffmiller.dev/contact",
  "mainEntity": {
    "@type": "Person",
    "name": "Geoffrey Miller",
    "jobTitle": "Infrastructure Director & Principal Cloud Architect",
    "url": "https://geoffmiller.dev",
    "sameAs": [
      "https://linkedin.com/in/geoff-e-miller",
      "https://github.com/GeoffMillerAZ"
    ],
    "knowsAbout": [
      "Platform Engineering",
      "Cloud Architecture",
      "Technical Leadership",
      "Kubernetes",
      "AWS",
      "DevOps"
    ]
  }
})} />