---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/navigation/Footer.astro';
import SeriesNavigation from '../../components/blog/SeriesNavigation.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

// Get related posts (same category, excluding current post)
const allBlogPosts = await getCollection('blog');
const relatedPosts = allBlogPosts
  .filter(post => post.data.category === entry.data.category && post.slug !== entry.slug)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .slice(0, 3);

const publishDate = new Date(entry.data.publishDate);
const readingTime = Math.ceil(entry.body.split(' ').length / 200); // Approximate reading time
---

<BaseLayout 
  title={`${entry.data.title} | Geoffrey Miller`}
  description={entry.data.description}
  canonical={`/blog/${entry.slug}`}
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumbs -->
    <nav class="mb-8">
      <div class="breadcrumbs text-sm">
        <ul>
          <li><a href="/" class="link link-hover">Home</a></li>
          <li><a href="/blog" class="link link-hover">Blog</a></li>
          <li class="opacity-70">{entry.data.title}</li>
        </ul>
      </div>
    </nav>

    <!-- Article Header -->
    <header class="mb-12">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <!-- Category and Meta -->
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <div class="badge badge-primary badge-lg capitalize">
              {entry.data.category.replace('-', ' ')}
            </div>
            <time class="text-sm text-base-content/70">
              {formatDate(publishDate)}
            </time>
            <div class="badge badge-outline badge-sm">
              {readingTime} min read
            </div>
          </div>

          <!-- Title -->
          <h1 class="card-title text-3xl md:text-4xl lg:text-5xl font-bold text-glow mb-6 leading-tight">
            {entry.data.title}
          </h1>

          <!-- Description -->
          <p class="text-lg text-base-content/80 leading-relaxed mb-6">
            {entry.data.description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag: string) => (
              <div class="badge badge-outline badge-sm">
                #{tag}
              </div>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Series Navigation (if part of a series) -->
    {entry.data.series && (
      <SeriesNavigation series={entry.data.series} currentSlug={entry.slug} />
    )}

    <!-- Article Content -->
    <article class="prose prose-lg prose-invert max-w-none">
      <div class="card p-8">
        <Content />
      </div>
    </article>

    <!-- AI Summary Section (if available) -->
    {entry.data.aiSummary && (
      <section class="mt-12">
        <div class="alert alert-info">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-2">AI Summary</h3>
            <p class="text-sm leading-relaxed">
              {entry.data.aiSummary}
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Share Section -->
    <section class="mt-12">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h3 class="card-title text-glow mb-4">Share this article</h3>
          <div class="card-actions flex-wrap gap-3">
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(`https://geoffmiller.dev/blog/${entry.slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
              Share on Twitter
            </a>
            <a 
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://geoffmiller.dev/blog/${entry.slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Share on LinkedIn
            </a>
            <button 
              onclick={`navigator.clipboard.writeText('https://geoffmiller.dev/blog/${entry.slug}'); this.textContent = 'Copied!'; setTimeout(() => this.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>Copy Link', 2000)`}
              class="btn btn-secondary btn-sm gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              Copy Link
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold text-glow mb-8">Related Articles</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedPosts.map((post) => (
            <article class="card card-compact bg-base-100 shadow-xl hover:shadow-2xl transition-all">
              <div class="card-body">
              <div class="flex items-center gap-3 mb-4">
                <div class="badge badge-accent badge-sm">
                  {post.data.category}
                </div>
                <time class="text-xs text-base-content/70">
                  {formatDate(new Date(post.data.publishDate))}
                </time>
              </div>
              
              <h3 class="font-bold text-glow mb-3 text-lg leading-tight hover:text-accent transition-colors">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h3>
              
              <p class="text-base-content/70 text-sm mb-4 leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
              
              <a 
                href={`/blog/${post.slug}`} 
                class="inline-flex items-center text-accent hover:brightness-125 transition-all text-sm font-medium"
              >
                Read more 
                <svg class="ml-1 w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Back to Blog -->
    <section class="mt-16">
      <div class="text-center">
        <a href="/blog" class="btn btn-secondary btn-wide gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to All Posts
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Custom prose styles for dark theme */
  .prose {
    color: var(--synth-text, #e5e5e5);
  }
  
  /* Apply glow effect to headings without @apply */
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: var(--synth-glow-text, #ffffff);
    text-shadow: 0 0 4px rgba(249, 42, 173, 0.4);
  }
  
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  
  .prose a {
    color: var(--synth-pink, #f92aad);
    transition: all 0.3s;
  }
  .prose a:hover {
    filter: brightness(1.25);
  }
  
  .prose blockquote {
    border-left: 4px solid var(--synth-pink, #f92aad);
    padding-left: 1rem;
    font-style: italic;
    opacity: 0.7;
  }
  
  .prose code {
    background-color: var(--synth-card-bg, rgba(36, 27, 47, 0.6));
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--synth-pink, #f92aad);
    font-size: 0.875rem;
  }
  
  .prose pre {
    background-color: var(--synth-card-bg, rgba(36, 27, 47, 0.6));
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--synth-border, rgba(114, 241, 184, 0.2));
    overflow-x: auto;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
  }
  
  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  
  .prose li {
    margin-bottom: 0.5rem;
  }
  
  .prose table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--synth-border, rgba(114, 241, 184, 0.2));
  }
  
  .prose th, .prose td {
    border: 1px solid var(--synth-border, rgba(114, 241, 184, 0.2));
    padding: 0.5rem 1rem;
  }
  
  .prose th {
    background-color: var(--synth-card-bg, rgba(36, 27, 47, 0.6));
    font-weight: 600;
  }
  
  .prose img {
    border-radius: 0.5rem;
    border: 1px solid var(--synth-border, rgba(114, 241, 184, 0.2));
  }
</style>

<!-- JSON-LD Structured Data for Article -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "author": {
    "@type": "Person",
    "name": "Geoffrey Miller",
    "url": "https://geoffmiller.dev"
  },
  "datePublished": entry.data.publishDate,
  "dateModified": entry.data.publishDate,
  "publisher": {
    "@type": "Person",
    "name": "Geoffrey Miller"
  },
  "url": `https://geoffmiller.dev/blog/${entry.slug}`,
  "keywords": entry.data.tags.join(", "),
  "articleSection": entry.data.category,
  "wordCount": entry.body.split(' ').length,
  "timeRequired": `PT${readingTime}M`
})} />