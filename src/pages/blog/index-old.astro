---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/navigation/Header.astro';
import Footer from '../../components/navigation/Footer.astro';

// Get all blog posts
const allBlogPosts = await getCollection('blog');

// Sort posts by publish date (newest first)
const sortedPosts = allBlogPosts.sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);

// Group posts by category
const categories = [...new Set(allBlogPosts.map(post => post.data.category))];
const postsByCategory = categories.reduce((acc, category) => {
  acc[category] = sortedPosts.filter(post => post.data.category === category);
  return acc;
}, {} as Record<string, typeof sortedPosts>);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<BaseLayout 
  title="Blog | Geoffrey Miller - Platform Engineering & Cloud Architecture Insights"
  description="Technical insights, platform engineering best practices, and cloud architecture deep-dives from Geoffrey Miller's 12+ years in the field."
>
  <Header />
  
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="card p-8 text-center">
        <h1 class="text-4xl font-bold text-glow mb-4">Technical Blog</h1>
        <p class="text-xl text-synth-text-muted max-w-3xl mx-auto">
          Deep dives into platform engineering, cloud architecture, and the evolving landscape 
          of infrastructure at scale. Practical insights from building and operating production systems.
        </p>
      </div>
    </section>

    {sortedPosts.length > 0 ? (
      <>
        <!-- Featured/Latest Post -->
        {sortedPosts[0] && (
          <section class="mb-12">
            <h2 class="text-2xl font-bold text-glow mb-6">Latest Post</h2>
            <article class="card p-8 hover:border-accent transition-colors">
              <div class="flex flex-col lg:flex-row gap-6">
                <div class="flex-1">
                  <div class="flex items-center gap-4 mb-4">
                    <span class="px-3 py-1 text-xs font-medium rounded-full bg-accent/20 text-accent border border-accent/30">
                      {sortedPosts[0].data.category}
                    </span>
                    <time class="text-sm text-synth-text-muted">
                      {formatDate(new Date(sortedPosts[0].data.publishDate))}
                    </time>
                  </div>
                  <h3 class="text-2xl font-bold text-glow mb-3 hover:text-accent transition-colors">
                    <a href={`/blog/${sortedPosts[0].slug}`}>
                      {sortedPosts[0].data.title}
                    </a>
                  </h3>
                  <p class="text-synth-text mb-4 leading-relaxed">
                    {sortedPosts[0].data.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {sortedPosts[0].data.tags.map((tag: string) => (
                      <span class="px-2 py-1 text-xs rounded bg-synth-card-bg text-synth-text-muted border border-synth-border">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <a 
                    href={`/blog/${sortedPosts[0].slug}`} 
                    class="inline-flex items-center text-accent hover:text-accent-light transition-colors"
                  >
                    Read more 
                    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          </section>
        )}

        <!-- All Posts by Category -->
        <section>
          <h2 class="text-2xl font-bold text-glow mb-8">All Posts</h2>
          
          {Object.entries(postsByCategory).map(([category, posts]) => (
            <div class="mb-10">
              <h3 class="text-xl font-semibold text-accent mb-6 capitalize flex items-center">
                <span class="w-8 h-0.5 bg-accent mr-3"></span>
                {category.replace('-', ' ')}
                <span class="ml-3 text-sm text-synth-text-muted font-normal">({posts.length})</span>
              </h3>
              
              <div class="grid gap-6">
                {posts.map((post) => (
                  <article class="card p-6 hover:border-accent transition-colors">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                      <div class="flex items-center gap-4">
                        <time class="text-sm text-synth-text-muted">
                          {formatDate(new Date(post.data.publishDate))}
                        </time>
                      </div>
                    </div>
                    
                    <h4 class="text-xl font-bold text-glow mb-3 hover:text-accent transition-colors">
                      <a href={`/blog/${post.slug}`}>
                        {post.data.title}
                      </a>
                    </h4>
                    
                    <p class="text-synth-text mb-4 leading-relaxed">
                      {post.data.description}
                    </p>
                    
                    <div class="flex flex-wrap items-center justify-between gap-4">
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.slice(0, 3).map((tag: string) => (
                          <span class="px-2 py-1 text-xs rounded bg-synth-card-bg text-synth-text-muted border border-synth-border">
                            {tag}
                          </span>
                        ))}
                        {post.data.tags.length > 3 && (
                          <span class="px-2 py-1 text-xs rounded bg-synth-card-bg text-synth-text-muted border border-synth-border">
                            +{post.data.tags.length - 3} more
                          </span>
                        )}
                      </div>
                      
                      <a 
                        href={`/blog/${post.slug}`} 
                        class="text-accent hover:text-accent-light transition-colors text-sm font-medium"
                      >
                        Read post →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>
      </>
    ) : (
      <!-- Empty state -->
      <section class="text-center py-16">
        <div class="card p-12">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-synth-card-bg border border-synth-border flex items-center justify-center">
            <svg class="w-8 h-8 text-synth-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-glow mb-4">Coming Soon</h2>
          <p class="text-synth-text-muted mb-6 max-w-md mx-auto">
            I'm working on creating valuable content about platform engineering, cloud architecture, 
            and technical leadership. Check back soon for in-depth articles and insights.
          </p>
          <a href="/" class="btn-primary">
            Back to Home
          </a>
        </div>
      </section>
    )}

    <!-- Newsletter Signup (Placeholder) -->
    <section class="mt-16">
      <div class="card p-8 text-center bg-gradient-to-r from-accent/5 to-accent-dark/5 border-accent/20">
        <h2 class="text-2xl font-bold text-glow mb-4">Stay Updated</h2>
        <p class="text-synth-text-muted mb-6 max-w-2xl mx-auto">
          Get notified when I publish new articles about platform engineering, cloud architecture, 
          and technical leadership insights.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="your@email.com" 
            class="flex-1 px-4 py-2 rounded-lg bg-synth-card-bg border border-synth-border text-synth-text focus:border-accent focus:outline-none"
          />
          <button class="btn-primary whitespace-nowrap">
            Subscribe
          </button>
        </div>
        <p class="text-xs text-synth-text-muted mt-4">
          Coming soon - newsletter functionality in development
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(138, 43, 226, 0.1);
  }
</style>