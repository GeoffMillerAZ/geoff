---
import HomeLayout from '../layouts/HomeLayout.astro';
import ProfileCard from '../components/home/ProfileCard.astro';
import SkillsSection from '../components/home/SkillsSection.astro';
import EducationSection from '../components/home/EducationSection.astro';
import CertificationsSection from '../components/home/CertificationsSection.astro';
import ExperienceTimelineNew from '../components/home/ExperienceTimelineNew.astro';
import AchievementsSection from '../components/home/AchievementsSection.astro';
import AwardsSection from '../components/home/AwardsSection.astro';
import { getSiteConfig } from '@/utils/siteData';

const siteConfig = getSiteConfig();
const { metadata, profile, resume } = siteConfig;
// CI/CD Test - Deployment fix verified: 2025-08-14
---

<HomeLayout title={metadata.title} description={metadata.description}>
  <main id="main-content" role="main" aria-label="Main content">
    <div class="max-w-7xl min-[2560px]:max-w-[1600px] mx-auto px-6 sm:px-8 py-8 sm:py-10 md:py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 sm:gap-10 lg:gap-12 xl:gap-16 min-[2560px]:gap-20">
        
        <!-- Left Column - Profile and Skills -->
        <aside class="lg:col-span-4 xl:col-span-3 min-[2560px]:col-span-3 lg:sticky lg:top-8 lg:self-start space-y-12 sm:space-y-10" role="complementary" aria-label="Geoffrey Miller profile and technical skills">
          <ProfileCard />
          
          <!-- Career Summary for mobile/tablet only - shows after Profile -->
          <div class="lg:hidden">
            <div class="card bg-base-200/80 shadow-xl">
              <div class="card-body">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 sm:gap-6 mb-6">
                  <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl text-glow-white">Professional Summary</h2>
                  <a 
                    href={resume.downloadUrl} 
                    download={resume.filename}
                    class="btn btn-primary btn-sm sm:btn-md gap-2 shrink-0"
                  >
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="hidden sm:inline">Download Resume</span>
                    <span class="sm:hidden">Resume</span>
                  </a>
                </div>
                
                <div class="prose prose-base max-w-none">
                  <p class="text-base leading-relaxed">
                    {profile.summary.brief}
                  </p>
                  <div class="collapse collapse-arrow bg-base-300/30 mt-4">
                    <input type="checkbox" />
                    <div class="collapse-title text-sm font-medium min-h-[44px] flex items-center">Read more</div>
                    <div class="collapse-content">
                      <p class="text-base leading-relaxed">
                        {profile.summary.extended}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Experience for mobile/tablet only - shows after Summary -->
          <div class="lg:hidden">
            <ExperienceTimelineNew />
          </div>
          
          <SkillsSection />
          
          <!-- Achievements for mobile/tablet -->
          <div class="lg:hidden">
            <AchievementsSection />
          </div>
          
          <!-- Awards, Education & Certs for mobile/tablet -->
          <div class="lg:hidden space-y-6 sm:space-y-8">
            <AwardsSection />
            <EducationSection />
            <CertificationsSection />
          </div>
        </aside>

        <!-- Main Content Area -->
        <div class="lg:col-span-8 xl:col-span-9 min-[2560px]:col-span-9">
          <div class="grid grid-cols-1 min-[2560px]:grid-cols-12 gap-12 sm:gap-10 lg:gap-12 min-[2560px]:gap-16">
            
            <!-- Center Column - Main Content -->
            <section class="min-[2560px]:col-span-7 space-y-12 sm:space-y-10 lg:space-y-12" aria-label="Career summary and experience">
              <!-- Hero Section with Career Summary - Hidden on mobile, shown on desktop -->
              <div class="hidden lg:block">
                <div class="card bg-base-200/80 shadow-xl">
                  <div class="card-body">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 sm:gap-6 mb-6">
                      <h2 class="card-title text-2xl sm:text-3xl lg:text-3xl text-glow-white">Career Summary</h2>
                      <a 
                        href={resume.downloadUrl} 
                        download
                        class="btn btn-primary btn-sm sm:btn-md gap-2 shrink-0"
                      >
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span class="hidden sm:inline">Download Resume</span>
                        <span class="sm:hidden">Resume</span>
                      </a>
                    </div>
                    
                    <div class="collapse collapse-arrow bg-base-300/30">
                      <input type="checkbox" />
                      <div class="collapse-title text-lg font-semibold py-4">
                        <p class="text-base sm:text-lg leading-relaxed line-clamp-3">
                          Infrastructure Director & Principal Cloud Architect with 12 years designing, leading, and operating cloud platforms 
                          (20 years in IT overall). Deep expertise in AWS Kubernetes and the broader CNCF ecosystem...
                        </p>
                      </div>
                      <div class="collapse-content">
                        <div class="prose prose-base max-w-none">
                          <p class="text-base sm:text-lg leading-relaxed">
                            Infrastructure Director & Principal Cloud Architect with 12 years designing, leading, and operating cloud platforms 
                            (20 years in IT overall). Deep expertise in AWS Kubernetes and the broader CNCF ecosystem with a strong focus on 
                            developer efficiency and platform scale. Designs platform services that unify tools into a single end-to-end experience 
                            using policy as code, mission control patterns, and fully automated CI/CD pipelines. FinOps specialist who pairs spend 
                            analytics with real-time event-driven automation to right-size resources and cut cloud costs by 30 percent or more 
                            without impacting reliability. Known for solving complex challenges through simple repeatable engineering patterns, 
                            mentoring high-performing teams, and managing stakeholders across business and technology. Advanced leader in AI-driven 
                            agentic workflows who built organization-wide coding platforms that combine AI-assisted development with controlled 
                            agent execution, generating service catalogs and policy code that triple developer throughput and maintain security, 
                            compliance, and consistency. Ready to bring forward-thinking cloud strategy and hands-on engineering leadership to 
                            highly regulated enterprises.
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Experience - Hidden on mobile, shown on desktop -->
              <div class="hidden lg:block">
                <ExperienceTimelineNew />
              </div>
              
              <!-- Achievements - Hidden on mobile, shown on desktop -->
              <div class="hidden lg:block">
                <AchievementsSection />
              </div>
              
            </section>

            <!-- Right Column - Education and Certifications (only for ultra-wide 2560px+) -->
            <aside class="hidden min-[2560px]:block min-[2560px]:col-span-5 min-[2560px]:sticky min-[2560px]:top-8 min-[2560px]:self-start space-y-6 lg:space-y-8" role="complementary" aria-label="Professional education and industry certifications">
              <AwardsSection />
              <EducationSection />
              <CertificationsSection />
            </aside>
          </div>
          
          <!-- Awards, Education & Certs for large/wide screens (not ultra-wide) -->
          <div class="hidden lg:block min-[2560px]:hidden space-y-6 lg:space-y-8">
            <!-- Awards Section -->
            <AwardsSection />
            
            <!-- Education & Certifications Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
              <EducationSection />
              <CertificationsSection />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</HomeLayout>