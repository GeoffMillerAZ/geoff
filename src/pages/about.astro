---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
---

<BaseLayout 
  title="About | Geoffrey Miller - Infrastructure Director & Principal Cloud Architect"
  description="Learn about Geoffrey Miller's 12+ years in cloud architecture, platform engineering, and leading high-performing technical teams at scale."
>
  <Header />
  
  <main id="main-content" class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 max-w-7xl" role="main" aria-label="About Geoffrey Miller">
    <!-- Hero Section -->
    <section class="mb-8 sm:mb-10 lg:mb-12">
      <div class="hero bg-base-100 shadow-xl rounded-2xl">
        <div class="hero-content flex-col lg:flex-row gap-6 lg:gap-8 p-4 sm:p-6 lg:p-8">
          <div class="avatar placeholder">
            <div class="bg-primary text-primary-content rounded-full w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 border-4 border-primary/20">
              <span class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-wider" aria-hidden="true">GM</span>
            </div>
          </div>
          <div class="text-center lg:text-left">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-glow mb-3 lg:mb-4">Geoffrey Miller</h1>
            <p class="text-lg sm:text-xl text-base-content opacity-70 mb-3 lg:mb-4">Infrastructure Director & Principal Cloud Architect</p>
            <p class="text-sm sm:text-base text-base-content leading-relaxed">
              With over 12 years of experience in cloud architecture and platform engineering, 
              I specialize in designing, building, and operating scalable cloud platforms that 
              enable engineering teams to deliver value faster and more reliably.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="mb-8 sm:mb-10 lg:mb-12">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 sm:p-6 lg:p-8">
          <h2 class="card-title text-xl sm:text-2xl text-glow mb-4 sm:mb-5 lg:mb-6">About Me</h2>
          <div class="prose prose-sm sm:prose-base lg:prose-lg max-w-none">
            <p class="text-sm sm:text-base text-base-content mb-3 sm:mb-4 leading-relaxed">
              I'm passionate about building platforms that empower developers and accelerate innovation. 
              Currently serving as Infrastructure Director at First Citizens Bank, I lead teams that 
              design and operate cloud-native platforms serving thousands of engineers and millions of customers.
            </p>
            <p class="text-sm sm:text-base text-base-content mb-3 sm:mb-4 leading-relaxed">
              My expertise spans the full spectrum of platform engineering - from Kubernetes orchestration 
              and service mesh architecture to developer experience and organizational transformation. 
              I believe in the power of automation, observability, and treating infrastructure as a product.
            </p>
            <p class="text-sm sm:text-base text-base-content leading-relaxed">
              When I'm not architecting the next generation of cloud platforms, you'll find me contributing 
              to open source projects, mentoring fellow engineers, and sharing knowledge through writing 
              and speaking at industry conferences.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Expertise Section -->
    <section class="mb-8 sm:mb-10 lg:mb-12">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 sm:p-6 lg:p-8">
          <h2 class="card-title text-xl sm:text-2xl text-glow mb-6 sm:mb-8 lg:mb-10">Core Expertise</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 sm:gap-8">
            <!-- Cloud Platforms -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">Cloud Platforms</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    AWS Architecture & Services
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Multi-cloud Strategy
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Cloud Cost Optimization
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Migration & Modernization
                  </li>
                </ul>
              </div>
            </div>
            
            <!-- Platform Engineering -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">Platform Engineering</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Kubernetes & Container Orchestration
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Service Mesh (Istio/Consul)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Developer Experience Platforms
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Internal Platform Design
                  </li>
                </ul>
              </div>
            </div>
            
            <!-- DevOps & SRE -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">DevOps & SRE</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    CI/CD Pipeline Architecture
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Infrastructure as Code
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Observability & Monitoring
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Incident Response & SLOs
                  </li>
                </ul>
              </div>
            </div>
            
            <!-- Leadership -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">Leadership</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Technical Team Leadership
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Engineering Culture & Practices
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Strategic Technology Planning
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Cross-functional Collaboration
                  </li>
                </ul>
              </div>
            </div>
            
            <!-- Technologies -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">Technologies</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Go, Python, TypeScript
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Terraform, Pulumi, CDK
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Prometheus, Grafana, Jaeger
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    ArgoCD, Flux, Helm
                  </li>
                </ul>
              </div>
            </div>
            
            <!-- Specializations -->
            <div class="stat bg-base-200 shadow-lg rounded-2xl p-4 sm:p-6 hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
              <div class="stat-figure text-primary">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div class="stat-title text-primary font-bold mb-3">Specializations</div>
              <div class="stat-desc">
                <ul class="space-y-2 text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Platform Product Management
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    API Gateway Architecture
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Security & Compliance
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1 h-1 bg-accent rounded-full"></span>
                    Performance Engineering
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Highlights -->
    <section class="mb-8 sm:mb-10 lg:mb-12">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 sm:p-6 lg:p-8">
          <h2 class="card-title text-xl sm:text-2xl text-glow mb-4 sm:mb-5 lg:mb-6">Career Highlights</h2>
          <div class="timeline timeline-vertical timeline-compact">
            <div class="timeline-item">
              <div class="timeline-start"></div>
              <div class="timeline-middle">
                <div class="bg-primary w-4 h-4 rounded-full"></div>
              </div>
              <div class="timeline-end p-4 sm:p-5 lg:p-6">
                <h3 class="text-sm sm:text-base font-semibold text-primary mb-2">Infrastructure Director - First Citizens Bank</h3>
                <div class="badge badge-outline badge-sm mb-2 sm:mb-3">2020 - Present</div>
                <p class="text-xs sm:text-sm text-base-content leading-relaxed">
                  Leading cloud platform strategy and engineering teams supporting 50+ applications 
                  and millions of banking customers. Spearheaded migration to cloud-native architecture 
                  resulting in 40% cost reduction and 3x faster deployment cycles.
                </p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-start"></div>
              <div class="timeline-middle">
                <div class="bg-primary w-4 h-4 rounded-full"></div>
              </div>
              <div class="timeline-end p-4 sm:p-5 lg:p-6">
                <h3 class="text-sm sm:text-base font-semibold text-primary mb-2">Principal Cloud Architect</h3>
                <div class="badge badge-outline badge-sm mb-2 sm:mb-3">2018 - 2020</div>
                <p class="text-xs sm:text-sm text-base-content leading-relaxed">
                  Designed and implemented enterprise Kubernetes platform serving 200+ microservices. 
                  Established SRE practices and observability stack, achieving 99.9% uptime SLA.
                </p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-start"></div>
              <div class="timeline-middle">
                <div class="bg-primary w-4 h-4 rounded-full"></div>
              </div>
              <div class="timeline-end p-4 sm:p-5 lg:p-6">
                <h3 class="text-sm sm:text-base font-semibold text-primary mb-2">Senior DevOps Engineer</h3>
                <div class="badge badge-outline badge-sm mb-2 sm:mb-3">2015 - 2018</div>
                <p class="text-xs sm:text-sm text-base-content leading-relaxed">
                  Built CI/CD pipelines and infrastructure automation, reducing deployment time from 
                  hours to minutes. Mentored engineering teams on cloud-native practices and tooling.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Connect Section -->
    <section>
      <div class="card bg-base-100 shadow-xl text-center">
        <div class="card-body p-4 sm:p-6 lg:p-8">
          <h2 class="card-title text-xl sm:text-2xl text-glow mb-3 sm:mb-4 justify-center">Let's Connect</h2>
          <p class="text-sm sm:text-base text-base-content opacity-70 mb-4 sm:mb-6 max-w-2xl mx-auto leading-relaxed">
            I'm always interested in discussing platform engineering, cloud architecture, 
            and the future of developer experience. Feel free to reach out!
          </p>
          <div class="card-actions justify-center flex-col sm:flex-row gap-3 sm:gap-4">
            <a 
              href="https://linkedin.com/in/geoff-e-miller" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-wide sm:btn-auto min-h-11 h-11"
              aria-label="Connect with Geoffrey Miller on LinkedIn"
            >
              LinkedIn
            </a>
            <a 
              href="https://github.com/GeoffMillerAZ" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-wide sm:btn-auto min-h-11 h-11"
              aria-label="View Geoffrey Miller's GitHub profile"
            >
              GitHub
            </a>
            <a 
              href="/contact" 
              class="btn btn-primary btn-wide sm:btn-auto min-h-11 h-11"
              aria-label="Contact Geoffrey Miller"
            >
              Contact Me
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .text-glow {
    text-shadow: 0 0 10px #f92aad;
  }
</style>