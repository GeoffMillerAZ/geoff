---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { 
  title = 'Geoffrey Miller - Infrastructure Director & Principal Cloud Architect',
  description = 'Infrastructure Director & Principal Cloud Architect with 12 years designing, leading, and operating cloud platforms. Deep expertise in AWS, Kubernetes, and the broader CNCF ecosystem.',
  image = '/og-image.png',
  canonical,
  noindex = false
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="Geoffrey Miller" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    
    <!-- Additional Meta Tags -->
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="author" content="Geoffrey Miller" />
    <meta name="theme-color" content="#2a2139" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Geoffrey Miller",
        "jobTitle": "Infrastructure Director & Principal Cloud Architect",
        "url": "https://geoffmiller.dev",
        "sameAs": [
          "https://github.com/GeoffMillerAZ",
          "https://linkedin.com/in/geoff-e-miller"
        ],
        "knowsAbout": [
          "Cloud Architecture",
          "Platform Engineering",
          "DevOps",
          "Kubernetes",
          "AWS",
          "Infrastructure as Code"
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "First Citizens Bank"
        }
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
    
    <!-- Analytics would go here -->
    <!-- Vercel Analytics -->
    <!-- PostHog Analytics -->
  </body>
</html>